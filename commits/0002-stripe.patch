+package org.migor.feedless.plan
+
+import org.migor.feedless.AppLayer
+import org.migor.feedless.AppProfiles
+import org.migor.feedless.payment.PaymentService
+import org.migor.feedless.payment.PaymentSession
+import org.slf4j.LoggerFactory
+import org.springframework.beans.factory.annotation.Autowired
+import org.springframework.context.annotation.Profile
+import org.springframework.stereotype.Service
+import org.springframework.transaction.annotation.Propagation
+import org.springframework.transaction.annotation.Transactional
+import java.util.*
+
+/**
+ * High-level payment service that integrates Stripe with the order system
+ * This service bridges the gap between your domain logic and the Stripe payment provider
+ */
+@Service
+@Transactional(propagation = Propagation.NEVER)
+@Profile("${AppProfiles.plan} & ${AppLayer.service}")
+class StripePaymentService {
+
+  private val log = LoggerFactory.getLogger(StripePaymentService::class.simpleName)
+
+  @Autowired
+  lateinit var paymentService: PaymentService
+
+  @Autowired
+  lateinit var productService: ProductService
+
+  /**
+   * Creates a payment session for an order
+   * 
+   * @param order The order to create payment for
+   * @param stripeProductId The Stripe product ID (managed in Stripe Dashboard)
+   * @param stripePriceId The Stripe price ID (managed in Stripe Dashboard)
+   * @param successUrl URL to redirect after successful payment
+   * @param cancelUrl URL to redirect if payment is cancelled
+   * @return Payment session with checkout URL
+   */
+  suspend fun createPaymentSessionForOrder(
+    order: OrderEntity,
+    stripeProductId: String,
+    stripePriceId: String,
+    successUrl: String,
+    cancelUrl: String
+  ): PaymentSession {
+    log.info("Creating payment session for order: ${order.id}")
+
+    return paymentService.createPaymentSession(
+      productId = stripeProductId,
+      priceId = stripePriceId,
+      userId = order.userId,
+      orderId = order.id,
+      successUrl = successUrl,
+      cancelUrl = cancelUrl,
+      metadata = mapOf(
+        "productName" to (order.product?.name ?: "Unknown"),
+        "invoiceRecipientEmail" to order.invoiceRecipientEmail,
+        "invoiceRecipientName" to order.invoiceRecipientName
+      )
+    )
+  }
+
+  /**
+   * Retrieves payment session status
+   * 
+   * @param sessionId Stripe session ID
+   * @return Payment session details
+   */
+  suspend fun getPaymentSessionStatus(sessionId: String): PaymentSession {
+    return paymentService.getPaymentSession(sessionId)
+  }
+
+  /**
+   * Retrieves all payments for an order
+   * 
+   * @param orderId Order ID
+   * @return List of payment transactions
+   */
+  suspend fun getPaymentsForOrder(orderId: UUID) = paymentService.getPaymentsByOrderId(orderId)
+}
+
