+
+# Use test API keys (will be overridden by environment variables in CI)
+stripe.api-key=${STRIPE_API_KEY:sk_test_DUMMY_KEY_FOR_TESTING}
+stripe.webhook-secret=${STRIPE_WEBHOOK_SECRET:whsec_DUMMY_SECRET_FOR_TESTING}
+
+# Logging configuration for tests
+logging.level.org.migor.feedless.payment.stripe=DEBUG
+
