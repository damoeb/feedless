--- /dev/null
+++ b/packages/server-core/src/main/kotlin/org/migor/feedless/session/MdcContext.kt
@@ -0,0 +1,91 @@
+package org.migor.feedless.session
+
+import kotlinx.coroutines.slf4j.MDCContext
+import kotlinx.coroutines.withContext
+import org.slf4j.MDC
+import kotlin.coroutines.CoroutineContext
+
+/**
+ * MDC keys used throughout the application for structured logging.
+ */
+object MdcKeys {
+  const val CORR_ID = "corrId"
+  const val USER_ID = "userId"
+  const val GROUP_ID = "groupId"
+}
+
+/**
+ * Creates a coroutine context that combines RequestContext with MDCContext,
+ * ensuring MDC values are propagated across coroutine boundaries and thread switches.
+ *
+ * Usage:
+ * ```
+ * withMdcContext(RequestContext(corrId = "abc123", userId = userId)) {
+ *   // MDC values are available here and propagated to child coroutines
+ *   log.info("Processing request") // Will include corrId, userId in MDC
+ * }
+ * ```
+ */
+suspend fun <T> withMdcContext(
+  requestContext: RequestContext,
+  block: suspend () -> T
+): T {
+  // Set MDC values from RequestContext
+  requestContext.corrId?.let { MDC.put(MdcKeys.CORR_ID, it) }
+  requestContext.userId?.let { MDC.put(MdcKeys.USER_ID, it.uuid.toString()) }
+  requestContext.groupId?.let { MDC.put(MdcKeys.GROUP_ID, it.uuid.toString()) }
+
+  return try {
+    // Combine RequestContext with MDCContext for proper propagation
+    withContext(requestContext + MDCContext()) {
+      block()
+    }
+  } finally {
+    // Clean up MDC when done
+    MDC.remove(MdcKeys.CORR_ID)
+    MDC.remove(MdcKeys.USER_ID)
+    MDC.remove(MdcKeys.GROUP_ID)
+  }
+}
+
+/**
+ * Creates a combined coroutine context with RequestContext and MDCContext.
+ * Use this when launching coroutines that need both request context and MDC propagation.
+ *
+ * Usage:
+ * ```
+ * launch(createMdcCoroutineContext(requestContext)) {
+ *   // Both RequestContext and MDC are available
+ * }
+ * ```
+ */
+fun createMdcCoroutineContext(requestContext: RequestContext): CoroutineContext {
+  // Set MDC values before creating the context
+  requestContext.corrId?.let { MDC.put(MdcKeys.CORR_ID, it) }
+  requestContext.userId?.let { MDC.put(MdcKeys.USER_ID, it.uuid.toString()) }
+  requestContext.groupId?.let { MDC.put(MdcKeys.GROUP_ID, it.uuid.toString()) }
+
+  return requestContext + MDCContext()
+}
+
+/**
+ * Updates MDC from the current RequestContext in the coroutine context.
+ * Call this after switching threads to ensure MDC is properly set.
+ */
+fun CoroutineContext.syncMdc() {
+  val requestContext = this[RequestContext]
+  requestContext?.corrId?.let { MDC.put(MdcKeys.CORR_ID, it) }
+  requestContext?.userId?.let { MDC.put(MdcKeys.USER_ID, it.uuid.toString()) }
+  requestContext?.groupId?.let { MDC.put(MdcKeys.GROUP_ID, it.uuid.toString()) }
+}
+
+/**
+ * Clears all application-specific MDC values.
+ */
+fun clearMdc() {
+  MDC.remove(MdcKeys.CORR_ID)
+  MDC.remove(MdcKeys.USER_ID)
+  MDC.remove(MdcKeys.GROUP_ID)
+}
+
+
