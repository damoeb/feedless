+import { Controller, Get, Logger } from '@nestjs/common';
+import { RabbitMQService } from '../messaging/rabbitmq.service';
+import { RabbitMQConfigService } from '../messaging/rabbitmq-config.service';
+import { RabbitMQAgentService } from '../services/agent/rabbitmq-agent.service';
+
+interface HealthStatus {
+  status: 'healthy' | 'unhealthy' | 'degraded';
+  timestamp: string;
+  uptime: number;
+  services: {
+    rabbitmq: {
+      status: 'connected' | 'disconnected' | 'disabled';
+      enabled: boolean;
+    };
+    agent: {
+      status: 'active' | 'inactive';
+      stats: any;
+    };
+  };
+  version: string;
+  environment: string;
+}
+
+@Controller('health')
+export class HealthController {
+  private readonly logger = new Logger(HealthController.name);
+
+  constructor(
+    private readonly rabbitMQService: RabbitMQService,
+    private readonly rabbitMQConfig: RabbitMQConfigService,
+    private readonly rabbitMQAgent: RabbitMQAgentService,
+  ) {}
+
+  @Get()
+  async getHealth(): Promise<HealthStatus> {
+    const startTime = Date.now();
+    
+    try {
+      const rabbitMQEnabled = this.rabbitMQConfig.isEnabled();
+      const rabbitMQHealthy = rabbitMQEnabled ? this.rabbitMQService.isHealthy() : false;
+      const agentStats = this.rabbitMQAgent.getStats();
+
+      const status: HealthStatus = {
+        status: this.determineOverallStatus(rabbitMQEnabled, rabbitMQHealthy),
+        timestamp: new Date().toISOString(),
+        uptime: process.uptime(),
+        services: {
+          rabbitmq: {
+            status: rabbitMQEnabled 
+              ? (rabbitMQHealthy ? 'connected' : 'disconnected')
+              : 'disabled',
+            enabled: rabbitMQEnabled,
+          },
+          agent: {
+            status: rabbitMQEnabled && rabbitMQHealthy ? 'active' : 'inactive',
+            stats: agentStats,
+          },
+        },
+        version: process.env.APP_VERSION || 'unknown',
+        environment: process.env.NODE_ENV || 'development',
+      };
+
+      const responseTime = Date.now() - startTime;
+      this.logger.debug(`Health check completed in ${responseTime}ms`);
+
+      return status;
+
+    } catch (error) {
+      this.logger.error('Health check failed', error);
+      
+      return {
+        status: 'unhealthy',
+        timestamp: new Date().toISOString(),
+        uptime: process.uptime(),
+        services: {
+          rabbitmq: {
+            status: 'disconnected',
+            enabled: this.rabbitMQConfig.isEnabled(),
+          },
+          agent: {
+            status: 'inactive',
+            stats: null,
+          },
+        },
+        version: process.env.APP_VERSION || 'unknown',
+        environment: process.env.NODE_ENV || 'development',
+      };
+    }
+  }
+
+  @Get('ready')
+  async getReadiness(): Promise<{ ready: boolean; message: string }> {
+    const rabbitMQEnabled = this.rabbitMQConfig.isEnabled();
+    
+    if (!rabbitMQEnabled) {
+      return {
+        ready: true,
+        message: 'Agent ready (RabbitMQ disabled)',
+      };
+    }
+
+    const rabbitMQHealthy = this.rabbitMQService.isHealthy();
+    
+    return {
+      ready: rabbitMQHealthy,
+      message: rabbitMQHealthy 
+        ? 'Agent ready and connected to RabbitMQ'
+        : 'Agent not ready - RabbitMQ connection issues',
+    };
+  }
+
+  @Get('live')
+  async getLiveness(): Promise<{ alive: boolean; message: string }> {
+    return {
+      alive: true,
+      message: 'Agent is alive',
+    };
+  }
+
+  private determineOverallStatus(
+    rabbitMQEnabled: boolean,
+    rabbitMQHealthy: boolean,
+  ): 'healthy' | 'unhealthy' | 'degraded' {
+    if (!rabbitMQEnabled) {
+      return 'degraded'; // Running but without RabbitMQ
+    }
+
+    if (rabbitMQHealthy) {
+      return 'healthy';
+    }
+
+    return 'unhealthy';
+  }
+}
