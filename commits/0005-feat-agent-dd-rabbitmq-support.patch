+import { Test, TestingModule } from '@nestjs/testing';
+import { RabbitMQConsumerService } from './rabbitmq-consumer.service';
+import { RabbitMQService } from './rabbitmq.service';
+import { RabbitMQConfigService } from './rabbitmq-config.service';
+import { RabbitMQProducerService } from './rabbitmq-producer.service';
+
+describe('RabbitMQConsumerService', () => {
+  let service: RabbitMQConsumerService;
+
+  const mockRabbitMQService = {
+    waitForConnection: jest.fn(),
+    getConsumerChannel: jest.fn(),
+  };
+
+  const mockRabbitMQConfigService = {
+    isEnabled: jest.fn(),
+    getConsumerConfig: jest.fn(),
+  };
+
+  const mockRabbitMQProducerService = {
+    sendAgentStatus: jest.fn(),
+    sendScrapeResponse: jest.fn(),
+    sendLog: jest.fn(),
+  };
+
+  beforeEach(async () => {
+    const module: TestingModule = await Test.createTestingModule({
+      providers: [
+        RabbitMQConsumerService,
+        {
+          provide: RabbitMQService,
+          useValue: mockRabbitMQService,
+        },
+        {
+          provide: RabbitMQConfigService,
+          useValue: mockRabbitMQConfigService,
+        },
+        {
+          provide: RabbitMQProducerService,
+          useValue: mockRabbitMQProducerService,
+        },
+      ],
+    }).compile();
+
+    service = module.get<RabbitMQConsumerService>(RabbitMQConsumerService);
+  });
+
+  it('should be defined', () => {
+    expect(service).toBeDefined();
+  });
+
+  describe('registerScrapeRequestHandler', () => {
+    it('should register a scrape request handler', () => {
+      const handler = jest.fn();
+      
+      service.registerScrapeRequestHandler(handler);
+      
+      expect(service.hasHandler()).toBe(true);
+    });
+  });
+
+  describe('unregisterScrapeRequestHandler', () => {
+    it('should unregister the scrape request handler', () => {
+      const handler = jest.fn();
+      
+      service.registerScrapeRequestHandler(handler);
+      expect(service.hasHandler()).toBe(true);
+      
+      service.unregisterScrapeRequestHandler();
+      expect(service.hasHandler()).toBe(false);
+    });
+  });
+
+  describe('hasHandler', () => {
+    it('should return false when no handler is registered', () => {
+      expect(service.hasHandler()).toBe(false);
+    });
+
+    it('should return true when a handler is registered', () => {
+      const handler = jest.fn();
+      service.registerScrapeRequestHandler(handler);
+      expect(service.hasHandler()).toBe(true);
+    });
+  });
+
+  describe('onModuleInit', () => {
+    it('should skip initialization when RabbitMQ is disabled', async () => {
+      mockRabbitMQConfigService.isEnabled.mockReturnValue(false);
+
+      await expect(service.onModuleInit()).resolves.not.toThrow();
+    });
+
+    it('should initialize consumers when RabbitMQ is enabled', async () => {
+      mockRabbitMQConfigService.isEnabled.mockReturnValue(true);
+      mockRabbitMQService.waitForConnection.mockResolvedValue(undefined);
+      
+      const mockChannelWrapper = {
+        addSetup: jest.fn().mockResolvedValue(undefined),
+      };
+      
+      mockRabbitMQService.getConsumerChannel.mockReturnValue(mockChannelWrapper);
+      mockRabbitMQConfigService.getConsumerConfig.mockReturnValue({
+        prefetch: 1,
+        noAck: false,
+        exclusive: false,
+      });
+
+      await service.onModuleInit();
+
+      expect(mockRabbitMQService.waitForConnection).toHaveBeenCalled();
+      expect(mockChannelWrapper.addSetup).toHaveBeenCalled();
+    });
+  });
+});
diff --git a/packages/agent/src/messaging/rabbitmq-consumer.service.ts b/packages/agent/src/messaging/rabbitmq-consumer.service.ts
new file mode 100644
index 00000000..bc765dad
--- /dev/null
+++ b/packages/agent/src/messaging/rabbitmq-consumer.service.ts
@@ -0,0 +1,213 @@
+import { Injectable, Logger, OnModuleInit } from '@nestjs/common';
+import * as amqp from 'amqplib';
+import { RabbitMQService } from './rabbitmq.service';
+import { RabbitMQConfigService } from './rabbitmq-config.service';
+import { RabbitMQProducerService } from './rabbitmq-producer.service';
+import {
+  ScrapeRequestMessage,
+  AGENT_QUEUES,
+} from './message.types';
+
+@Injectable()
+export class RabbitMQConsumerService implements OnModuleInit {
+  private readonly logger = new Logger(RabbitMQConsumerService.name);
+  private scrapeRequestHandler: ((message: ScrapeRequestMessage) => Promise<any>) | null = null;
+
+  constructor(
+    private readonly rabbitMQService: RabbitMQService,
+    private readonly configService: RabbitMQConfigService,
+    private readonly producerService: RabbitMQProducerService,
+  ) {}
+
+  async onModuleInit() {
+    if (!this.configService.isEnabled()) {
+      this.logger.warn('RabbitMQ is disabled, skipping consumer initialization');
+      return;
+    }
+
+    try {
+      await this.rabbitMQService.waitForConnection();
+      await this.startConsumers();
+    } catch (error) {
+      this.logger.error('Failed to initialize RabbitMQ consumers', error);
+      throw error;
+    }
+  }
+
+  private async startConsumers() {
+    this.logger.log('Starting RabbitMQ consumers');
+    
+    const channel = this.rabbitMQService.getConsumerChannel();
+    const consumerConfig = this.configService.getConsumerConfig();
+
+    // Start scrape request consumer
+    await channel.addSetup(async (ch: amqp.Channel) => {
+      await ch.consume(
+        AGENT_QUEUES.SCRAPE_REQUESTS,
+        async (msg) => {
+          if (msg) {
+            await this.handleScrapeRequest(ch, msg);
+          }
+        },
+        {
+          noAck: consumerConfig.noAck,
+          exclusive: consumerConfig.exclusive,
+        },
+      );
+
+      this.logger.log(`Started consuming from ${AGENT_QUEUES.SCRAPE_REQUESTS}`);
+    });
+
+    // Start dead letter queue consumer
+    await channel.addSetup(async (ch: amqp.Channel) => {
+      await ch.consume(
+        AGENT_QUEUES.SCRAPE_REQUESTS_DLQ,
+        async (msg) => {
+          if (msg) {
+            await this.handleDeadLetterMessage(ch, msg);
+          }
+        },
+        {
+          noAck: false,
+        },
+      );
+
+      this.logger.log(`Started consuming from ${AGENT_QUEUES.SCRAPE_REQUESTS_DLQ}`);
+    });
+  }
+
+  private async handleScrapeRequest(channel: amqp.Channel, msg: amqp.ConsumeMessage) {
+    try {
+      const message: ScrapeRequestMessage = JSON.parse(msg.content.toString());
+      
+      this.logger.log(`Received scrape request: ${message.callbackId}`);
+      this.logger.debug(`Scrape request details:`, message);
+
+      // Send agent status as busy
+      await this.producerService.sendAgentStatus('BUSY', {
+        processingJob: message.callbackId,
+      });
+
+      let scrapeResponse: any;
+
+      if (this.scrapeRequestHandler) {
+        // Use custom handler if registered
+        scrapeResponse = await this.scrapeRequestHandler(message);
+      } else {
+        // Default response if no handler is registered
+        this.logger.warn('No scrape request handler registered, sending default response');
+        scrapeResponse = {
+          ok: false,
+          errorMessage: 'No scrape request handler registered',
+          outputs: [],
+          logs: ['No handler available'],
+        };
+      }
+
+      // Send response back
+      await this.producerService.sendScrapeResponse(
+        message.callbackId,
+        message.corrId || '',
+        scrapeResponse,
+      );
+
+      // Send agent status back to online
+      await this.producerService.sendAgentStatus('ONLINE');
+
+      // Acknowledge the message
+      channel.ack(msg);
+
+      this.logger.log(`Successfully processed scrape request: ${message.callbackId}`);
+
+    } catch (error) {
+      this.logger.error('Failed to process scrape request', error);
+
+      try {
+        const message: ScrapeRequestMessage = JSON.parse(msg.content.toString());
+        
+        // Send error response
+        await this.producerService.sendScrapeResponse(
+          message.callbackId,
+          message.corrId || '',
+          {
+            ok: false,
+            errorMessage: error.message || 'Unknown error occurred',
+            outputs: [],
+            logs: [error.stack || error.message],
+          },
+        );
+
+        // Send agent status back to online
+        await this.producerService.sendAgentStatus('ONLINE');
+
+      } catch (responseError) {
+        this.logger.error('Failed to send error response', responseError);
+      }
+
+      // Reject the message, it will go to DLQ if configured
+      channel.nack(msg, false, false);
+    }
+  }
+
+  private async handleDeadLetterMessage(channel: amqp.Channel, msg: amqp.ConsumeMessage) {
+    try {
+      const message = JSON.parse(msg.content.toString());
+      
+      this.logger.error('Processing dead letter message:', {
+        messageId: message.messageId,
+        messageType: message.messageType,
+        timestamp: message.timestamp,
+      });
+
+      // Log the failed message for analysis
+      await this.producerService.sendLog(
+        'error',
+        'Dead letter message processed',
+        'RabbitMQConsumerService',
+        undefined,
+        {
+          originalMessage: message,
+          deliveryInfo: {
+            exchange: msg.fields.exchange,
+            routingKey: msg.fields.routingKey,
+            redelivered: msg.fields.redelivered,
+          },
+        },
+      );
+
+      // Acknowledge the dead letter message
+      channel.ack(msg);
+
+    } catch (error) {
+      this.logger.error('Failed to process dead letter message', error);
+      
+      // Reject the message to avoid infinite loops
+      channel.nack(msg, false, false);
+    }
+  }
+
+  /**
+   * Register a custom handler for scrape requests
+   */
+  registerScrapeRequestHandler(
+    handler: (message: ScrapeRequestMessage) => Promise<any>,
+  ): void {
+    this.logger.log('Registering scrape request handler');
+    this.scrapeRequestHandler = handler;
+  }
+
+  /**
+   * Unregister the scrape request handler
+   */
+  unregisterScrapeRequestHandler(): void {
+    this.logger.log('Unregistering scrape request handler');
+    this.scrapeRequestHandler = null;
+  }
+
+  /**
+   * Check if a scrape request handler is registered
+   */
+  hasHandler(): boolean {
+    return this.scrapeRequestHandler !== null;
+  }
+}
