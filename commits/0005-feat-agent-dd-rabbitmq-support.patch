+import { Injectable, Logger, OnModuleInit, OnModuleDestroy } from '@nestjs/common';
+import * as amqp from 'amqplib';
+import * as amqpConnectionManager from 'amqp-connection-manager';
+import { RabbitMQConfigService } from './rabbitmq-config.service';
+import { AGENT_EXCHANGES, AGENT_QUEUES, AGENT_ROUTING_KEYS } from './message.types';
+
+@Injectable()
+export class RabbitMQService implements OnModuleInit, OnModuleDestroy {
+  private readonly logger = new Logger(RabbitMQService.name);
+  private connection: amqpConnectionManager.AmqpConnectionManager;
+  private publisherChannel: amqpConnectionManager.ChannelWrapper;
+  private consumerChannel: amqpConnectionManager.ChannelWrapper;
+  private isConnected = false;
+
+  constructor(private readonly configService: RabbitMQConfigService) {}
+
+  async onModuleInit() {
+    if (!this.configService.isEnabled()) {
+      this.logger.warn('RabbitMQ is disabled, skipping initialization');
+      return;
+    }
+
+    try {
+      await this.connect();
+      await this.setupTopology();
+    } catch (error) {
+      this.logger.error('Failed to initialize RabbitMQ service', error);
+      throw error;
+    }
+  }
+
+  async onModuleDestroy() {
+    await this.disconnect();
+  }
+
+  private async connect() {
+    const connectionConfig = this.configService.getConnectionConfig();
+    const connectionUrl = this.configService.getConnectionUrl();
+
+    this.logger.log(`Connecting to RabbitMQ at ${connectionConfig.host}:${connectionConfig.port}`);
+
+    this.connection = amqpConnectionManager.connect([connectionUrl], {
+      heartbeatIntervalInSeconds: connectionConfig.heartbeat,
+      reconnectTimeInSeconds: connectionConfig.reconnectDelay / 1000,
+    });
+
+    this.connection.on('connect', () => {
+      this.logger.log('Successfully connected to RabbitMQ');
+      this.isConnected = true;
+    });
+
+    this.connection.on('disconnect', (params) => {
+      this.logger.warn('Disconnected from RabbitMQ', params);
+      this.isConnected = false;
+    });
+
+    this.connection.on('connectFailed', (params) => {
+      this.logger.error('Failed to connect to RabbitMQ', params);
+      this.isConnected = false;
+    });
+
+    // Create publisher channel
+    this.publisherChannel = this.connection.createChannel({
+      json: true,
+      setup: async (channel: amqp.Channel) => {
+        const publisherConfig = this.configService.getPublisherConfig();
+        if (publisherConfig.confirm) {
+          // Enable publisher confirms
+          await (channel as any).confirmSelect();
+        }
+        return channel;
+      },
+    });
+
+    // Create consumer channel
+    this.consumerChannel = this.connection.createChannel({
+      json: true,
+      setup: async (channel: amqp.Channel) => {
+        const consumerConfig = this.configService.getConsumerConfig();
+        await channel.prefetch(consumerConfig.prefetch);
+        return channel;
+      },
+    });
+  }
+
+  private async setupTopology() {
+    this.logger.log('Setting up RabbitMQ topology');
+
+    try {
+      await this.publisherChannel.addSetup(async (channel: amqp.Channel) => {
+        // Create exchanges
+        await channel.assertExchange(AGENT_EXCHANGES.MAIN, 'topic', {
+          durable: true,
+        });
+
+        await channel.assertExchange(AGENT_EXCHANGES.DLX, 'topic', {
+          durable: true,
+        });
+
+        // Create queues with dead letter configuration
+        const queueConfig = this.configService.getQueueConfig();
+        const dlxArgs = {
+          'x-dead-letter-exchange': AGENT_EXCHANGES.DLX,
+        };
+
+        // Scrape request queue
+        await channel.assertQueue(AGENT_QUEUES.SCRAPE_REQUESTS, {
+          ...queueConfig,
+          arguments: {
+            ...queueConfig.arguments,
+            ...dlxArgs,
+            'x-dead-letter-routing-key': `${AGENT_ROUTING_KEYS.SCRAPE_REQUEST}.dlq`,
+          },
+        });
+
+        await channel.bindQueue(
+          AGENT_QUEUES.SCRAPE_REQUESTS,
+          AGENT_EXCHANGES.MAIN,
+          AGENT_ROUTING_KEYS.SCRAPE_REQUEST,
+        );
+
+        // Scrape response queue
+        await channel.assertQueue(AGENT_QUEUES.SCRAPE_RESPONSES, {
+          ...queueConfig,
+          arguments: {
+            ...queueConfig.arguments,
+            ...dlxArgs,
+            'x-dead-letter-routing-key': `${AGENT_ROUTING_KEYS.SCRAPE_RESPONSE}.dlq`,
+          },
+        });
+
+        await channel.bindQueue(
+          AGENT_QUEUES.SCRAPE_RESPONSES,
+          AGENT_EXCHANGES.MAIN,
+          AGENT_ROUTING_KEYS.SCRAPE_RESPONSE,
+        );
+
+        // Agent status queue
+        await channel.assertQueue(AGENT_QUEUES.AGENT_STATUS, queueConfig);
+        await channel.bindQueue(
+          AGENT_QUEUES.AGENT_STATUS,
+          AGENT_EXCHANGES.MAIN,
+          AGENT_ROUTING_KEYS.AGENT_STATUS,
+        );
+
+        // Agent heartbeat queue
+        await channel.assertQueue(AGENT_QUEUES.AGENT_HEARTBEAT, queueConfig);
+        await channel.bindQueue(
+          AGENT_QUEUES.AGENT_HEARTBEAT,
+          AGENT_EXCHANGES.MAIN,
+          AGENT_ROUTING_KEYS.AGENT_HEARTBEAT,
+        );
+
+        // Agent logs queue
+        await channel.assertQueue(AGENT_QUEUES.AGENT_LOGS, queueConfig);
+        await channel.bindQueue(
+          AGENT_QUEUES.AGENT_LOGS,
+          AGENT_EXCHANGES.MAIN,
+          AGENT_ROUTING_KEYS.AGENT_LOGS,
+        );
+
+        // Agent metrics queue
+        await channel.assertQueue(AGENT_QUEUES.AGENT_METRICS, queueConfig);
+        await channel.bindQueue(
+          AGENT_QUEUES.AGENT_METRICS,
+          AGENT_EXCHANGES.MAIN,
+          AGENT_ROUTING_KEYS.AGENT_METRICS,
+        );
+
+        // Dead letter queues
+        await channel.assertQueue(AGENT_QUEUES.SCRAPE_REQUESTS_DLQ, queueConfig);
+        await channel.bindQueue(
+          AGENT_QUEUES.SCRAPE_REQUESTS_DLQ,
+          AGENT_EXCHANGES.DLX,
+          `${AGENT_ROUTING_KEYS.SCRAPE_REQUEST}.dlq`,
+        );
+
+        await channel.assertQueue(AGENT_QUEUES.SCRAPE_RESPONSES_DLQ, queueConfig);
+        await channel.bindQueue(
+          AGENT_QUEUES.SCRAPE_RESPONSES_DLQ,
+          AGENT_EXCHANGES.DLX,
+          `${AGENT_ROUTING_KEYS.SCRAPE_RESPONSE}.dlq`,
+        );
+
+        this.logger.log('RabbitMQ topology setup complete');
+      });
+    } catch (error) {
+      this.logger.error('Failed to setup RabbitMQ topology', error);
+      throw error;
+    }
+  }
+
+  async disconnect() {
+    if (this.connection) {
+      this.logger.log('Disconnecting from RabbitMQ');
+      await this.connection.close();
+      this.isConnected = false;
+    }
+  }
+
+  getPublisherChannel(): amqpConnectionManager.ChannelWrapper {
+    if (!this.publisherChannel) {
+      throw new Error('Publisher channel not initialized');
+    }
+    return this.publisherChannel;
+  }
+
+  getConsumerChannel(): amqpConnectionManager.ChannelWrapper {
+    if (!this.consumerChannel) {
+      throw new Error('Consumer channel not initialized');
+    }
+    return this.consumerChannel;
+  }
+
+  isHealthy(): boolean {
+    return this.isConnected && this.connection && !this.connection.isConnected();
+  }
+
+  async waitForConnection(timeoutMs: number = 10000): Promise<void> {
+    return new Promise((resolve, reject) => {
+      if (this.isConnected) {
+        resolve();
+        return;
+      }
+
+      const timeout = setTimeout(() => {
+        reject(new Error('Connection timeout'));
+      }, timeoutMs);
+
+      const checkConnection = () => {
+        if (this.isConnected) {
+          clearTimeout(timeout);
+          resolve();
+        } else {
+          setTimeout(checkConnection, 100);
+        }
+      };
+
+      checkConnection();
+    });
+  }
+}
