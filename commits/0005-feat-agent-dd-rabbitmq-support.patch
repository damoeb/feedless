diff --git a/packages/agent/src/services/agent/rabbitmq-agent.service.ts b/packages/agent/src/services/agent/rabbitmq-agent.service.ts
new file mode 100644
index 00000000..0a4c4c3e
--- /dev/null
+++ b/packages/agent/src/services/agent/rabbitmq-agent.service.ts
@@ -0,0 +1,245 @@
+import { Injectable, Logger, OnModuleInit } from '@nestjs/common';
+import { PuppeteerService } from '../puppeteer/puppeteer.service';
+import { VerboseConfigService } from '../common/verbose-config.service';
+import { RabbitMQConsumerService } from '../../messaging/rabbitmq-consumer.service';
+import { RabbitMQProducerService } from '../../messaging/rabbitmq-producer.service';
+import { RabbitMQConfigService } from '../../messaging/rabbitmq-config.service';
+import { ScrapeRequestMessage } from '../../messaging/message.types';
+import { ScrapeResponseInput } from '../../generated/graphql';
+
+interface AgentStats {
+  startTime: number;
+  completedJobs: number;
+  failedJobs: number;
+  activeJobs: number;
+  processingTimes: number[];
+}
+
+@Injectable()
+export class RabbitMQAgentService implements OnModuleInit {
+  private readonly logger = new Logger(RabbitMQAgentService.name);
+  private stats: AgentStats = {
+    startTime: Date.now(),
+    completedJobs: 0,
+    failedJobs: 0,
+    activeJobs: 0,
+    processingTimes: [],
+  };
+  private heartbeatInterval: NodeJS.Timeout | null = null;
+  private metricsInterval: NodeJS.Timeout | null = null;
+
+  constructor(
+    private readonly puppeteerService: PuppeteerService,
+    private readonly config: VerboseConfigService,
+    private readonly consumerService: RabbitMQConsumerService,
+    private readonly producerService: RabbitMQProducerService,
+    private readonly rabbitMQConfig: RabbitMQConfigService,
+  ) {}
+
+  async onModuleInit() {
+    if (!this.rabbitMQConfig.isEnabled()) {
+      this.logger.warn('RabbitMQ is disabled, RabbitMQAgentService will not start');
+      return;
+    }
+
+    try {
+      await this.initialize();
+    } catch (error) {
+      this.logger.error('Failed to initialize RabbitMQAgentService', error);
+      throw error;
+    }
+  }
+
+  private async initialize() {
+    this.logger.log('Initializing RabbitMQ Agent Service');
+
+    // Register scrape request handler
+    this.consumerService.registerScrapeRequestHandler(
+      this.handleScrapeRequest.bind(this),
+    );
+
+    // Send initial status
+    await this.producerService.sendAgentStatus('ONLINE', {
+      capabilities: ['web-scraping', 'puppeteer'],
+      version: process.env.APP_VERSION || 'unknown',
+      nodeVersion: process.version,
+    });
+
+    // Start heartbeat
+    this.startHeartbeat();
+
+    // Start metrics reporting
+    this.startMetricsReporting();
+
+    this.logger.log('RabbitMQ Agent Service initialized successfully');
+  }
+
+  private async handleScrapeRequest(message: ScrapeRequestMessage): Promise<any> {
+    const startTime = Date.now();
+    this.stats.activeJobs++;
+
+    try {
+      this.logger.log(`Processing scrape request: ${message.callbackId}`);
+      this.logger.debug(`Scrape URL: ${message.scrapeRequest.url}`);
+
+      // Convert RabbitMQ message to puppeteer service format
+      const scrapeRequest = {
+        ...message.scrapeRequest,
+        corrId: message.corrId,
+        callbackId: message.callbackId,
+      };
+
+      // Process with puppeteer service
+      const scrapeResponse = await this.puppeteerService.submit(scrapeRequest as any);
+
+      // Update stats
+      const processingTime = Date.now() - startTime;
+      this.stats.completedJobs++;
+      this.stats.activeJobs--;
+      this.stats.processingTimes.push(processingTime);
+
+      // Keep only last 100 processing times for metrics
+      if (this.stats.processingTimes.length > 100) {
+        this.stats.processingTimes = this.stats.processingTimes.slice(-100);
+      }
+
+      this.logger.log(
+        `Successfully processed scrape request: ${message.callbackId} in ${processingTime}ms`,
+      );
+
+      return scrapeResponse;
+
+    } catch (error) {
+      this.logger.error(
+        `Failed to process scrape request: ${message.callbackId}`,
+        error,
+      );
+
+      // Update stats
+      this.stats.failedJobs++;
+      this.stats.activeJobs--;
+
+      // Send error log
+      await this.producerService.sendLog(
+        'error',
+        `Scrape request failed: ${error.message}`,
+        'RabbitMQAgentService',
+        error.stack,
+        {
+          callbackId: message.callbackId,
+          corrId: message.corrId,
+          url: message.scrapeRequest.url,
+        },
+      );
+
+      // Return error response
+      const errorResponse: ScrapeResponseInput = {
+        ok: false,
+        errorMessage: error.message || 'Unknown error occurred',
+        outputs: [],
+        logs: [error.stack || error.message],
+      };
+
+      return errorResponse;
+    }
+  }
+
+  private startHeartbeat() {
+    const heartbeatInterval = this.config.getNumber('RABBITMQ_HEARTBEAT_INTERVAL', {
+      fallback: 30000, // 30 seconds
+    });
+
+    this.heartbeatInterval = setInterval(async () => {
+      try {
+        await this.producerService.sendHeartbeat(
+          this.stats.activeJobs,
+          this.stats.completedJobs,
+          this.stats.failedJobs,
+        );
+      } catch (error) {
+        this.logger.error('Failed to send heartbeat', error);
+      }
+    }, heartbeatInterval);
+
+    this.logger.log(`Heartbeat started with interval: ${heartbeatInterval}ms`);
+  }
+
+  private startMetricsReporting() {
+    const metricsInterval = this.config.getNumber('RABBITMQ_METRICS_INTERVAL', {
+      fallback: 60000, // 1 minute
+    });
+
+    this.metricsInterval = setInterval(async () => {
+      try {
+        const averageProcessingTime = this.calculateAverageProcessingTime();
+        const errorRate = this.calculateErrorRate();
+
+        await this.producerService.sendMetrics(
+          this.stats.completedJobs,
+          averageProcessingTime,
+          errorRate,
+        );
+      } catch (error) {
+        this.logger.error('Failed to send metrics', error);
+      }
+    }, metricsInterval);
+
+    this.logger.log(`Metrics reporting started with interval: ${metricsInterval}ms`);
+  }
+
+  private calculateAverageProcessingTime(): number {
+    if (this.stats.processingTimes.length === 0) {
+      return 0;
+    }
+
+    const sum = this.stats.processingTimes.reduce((a, b) => a + b, 0);
+    return sum / this.stats.processingTimes.length;
+  }
+
+  private calculateErrorRate(): number {
+    const totalJobs = this.stats.completedJobs + this.stats.failedJobs;
+    if (totalJobs === 0) {
+      return 0;
+    }
+
+    return this.stats.failedJobs / totalJobs;
+  }
+
+  async shutdown() {
+    this.logger.log('Shutting down RabbitMQ Agent Service');
+
+    // Send offline status
+    try {
+      await this.producerService.sendAgentStatus('OFFLINE', {
+        reason: 'shutdown',
+        uptime: Date.now() - this.stats.startTime,
+      });
+    } catch (error) {
+      this.logger.error('Failed to send offline status', error);
+    }
+
+    // Clear intervals
+    if (this.heartbeatInterval) {
+      clearInterval(this.heartbeatInterval);
+      this.heartbeatInterval = null;
+    }
+
+    if (this.metricsInterval) {
+      clearInterval(this.metricsInterval);
+      this.metricsInterval = null;
+    }
+
+    // Unregister handler
+    this.consumerService.unregisterScrapeRequestHandler();
+
+    this.logger.log('RabbitMQ Agent Service shutdown complete');
+  }
+
+  getStats(): AgentStats {
+    return { ...this.stats };
+  }
+
+  getAgentId(): string {
+    return this.producerService.getAgentId();
+  }
+}
