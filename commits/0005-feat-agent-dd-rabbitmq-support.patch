+import { Injectable, Logger } from '@nestjs/common';
+import { VerboseConfigService } from '../services/common/verbose-config.service';
+
+export interface RabbitMQConnectionConfig {
+  host: string;
+  port: number;
+  username: string;
+  password: string;
+  vhost: string;
+  heartbeat: number;
+  connectionTimeout: number;
+  reconnectAttempts: number;
+  reconnectDelay: number;
+}
+
+export interface RabbitMQQueueConfig {
+  durable: boolean;
+  exclusive: boolean;
+  autoDelete: boolean;
+  arguments?: Record<string, any>;
+}
+
+@Injectable()
+export class RabbitMQConfigService {
+  private readonly logger = new Logger(RabbitMQConfigService.name);
+
+  constructor(private readonly config: VerboseConfigService) {}
+
+  getConnectionConfig(): RabbitMQConnectionConfig {
+    const host = this.config.getString('RABBITMQ_HOST', {
+      fallback: 'localhost',
+    });
+
+    const port = this.config.getNumber('RABBITMQ_PORT', {
+      fallback: 5672,
+    });
+
+    const username = this.config.getString('RABBITMQ_USERNAME', {
+      fallback: 'guest',
+    });
+
+    const password = this.config.getString('RABBITMQ_PASSWORD', {
+      fallback: 'guest',
+      mask: 4,
+    });
+
+    const vhost = this.config.getString('RABBITMQ_VHOST', {
+      fallback: '/',
+    });
+
+    const heartbeat = this.config.getNumber('RABBITMQ_HEARTBEAT', {
+      fallback: 60,
+    });
+
+    const connectionTimeout = this.config.getNumber('RABBITMQ_CONNECTION_TIMEOUT', {
+      fallback: 30000,
+    });
+
+    const reconnectAttempts = this.config.getNumber('RABBITMQ_RECONNECT_ATTEMPTS', {
+      fallback: 10,
+    });
+
+    const reconnectDelay = this.config.getNumber('RABBITMQ_RECONNECT_DELAY', {
+      fallback: 5000,
+    });
+
+    this.logger.log(`RabbitMQ connection config: ${host}:${port}${vhost}`);
+
+    return {
+      host,
+      port,
+      username,
+      password,
+      vhost,
+      heartbeat,
+      connectionTimeout,
+      reconnectAttempts,
+      reconnectDelay,
+    };
+  }
+
+  getConnectionUrl(): string {
+    const config = this.getConnectionConfig();
+    return `amqp://${config.username}:${config.password}@${config.host}:${config.port}${config.vhost}`;
+  }
+
+  getQueueConfig(): RabbitMQQueueConfig {
+    return {
+      durable: this.config.getBoolean('RABBITMQ_QUEUE_DURABLE', { fallback: true }),
+      exclusive: this.config.getBoolean('RABBITMQ_QUEUE_EXCLUSIVE', { fallback: false }),
+      autoDelete: this.config.getBoolean('RABBITMQ_QUEUE_AUTO_DELETE', { fallback: false }),
+      arguments: {
+        'x-message-ttl': this.config.getNumber('RABBITMQ_MESSAGE_TTL', {
+          fallback: 86400000, // 24 hours
+        }),
+        'x-max-length': this.config.getNumber('RABBITMQ_QUEUE_MAX_LENGTH', {
+          fallback: 10000,
+        }),
+      },
+    };
+  }
+
+  getConsumerConfig() {
+    return {
+      prefetch: this.config.getNumber('RABBITMQ_PREFETCH_COUNT', {
+        fallback: 1,
+      }),
+      noAck: this.config.getBoolean('RABBITMQ_NO_ACK', {
+        fallback: false,
+      }),
+      exclusive: this.config.getBoolean('RABBITMQ_CONSUMER_EXCLUSIVE', {
+        fallback: false,
+      }),
+    };
+  }
+
+  getPublisherConfig() {
+    return {
+      confirm: this.config.getBoolean('RABBITMQ_PUBLISHER_CONFIRM', {
+        fallback: true,
+      }),
+      mandatory: this.config.getBoolean('RABBITMQ_PUBLISHER_MANDATORY', {
+        fallback: true,
+      }),
+      persistent: this.config.getBoolean('RABBITMQ_MESSAGE_PERSISTENT', {
+        fallback: true,
+      }),
+    };
+  }
+
+  getAgentId(): string {
+    return this.config.getString('AGENT_ID', {
+      fallback: `agent-${Math.random().toString(36).substring(7)}`,
+    });
+  }
+
+  isEnabled(): boolean {
+    return this.config.getBoolean('RABBITMQ_ENABLED', {
+      fallback: true,
+    });
+  }
+}
