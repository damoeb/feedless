@@ -0,0 +1,132 @@
+export interface BaseMessage {
+  messageId: string;
+  timestamp: string;
+  messageType: string;
+  corrId?: string;
+}
+
+export interface ScrapeRequestMessage extends BaseMessage {
+  messageType: 'SCRAPE_REQUEST';
+  callbackId: string;
+  scrapeRequest: {
+    url: string;
+    actions?: any[];
+    options?: {
+      timeout?: number;
+      userAgent?: string;
+      viewport?: {
+        width: number;
+        height: number;
+      };
+      cookies?: any[];
+      headers?: Record<string, string>;
+    };
+  };
+  priority?: number;
+}
+
+export interface ScrapeResponseMessage extends BaseMessage {
+  messageType: 'SCRAPE_RESPONSE';
+  callbackId: string;
+  scrapeResponse: {
+    ok: boolean;
+    url?: string;
+    errorMessage?: string;
+    outputs: any[];
+    logs: string[];
+    debug?: {
+      corrId: string;
+      console: string[];
+      cookies: any[];
+      statusCode: number;
+      metrics: {
+        render: number;
+        queue: number;
+      };
+      network: any[];
+      prerendered: boolean;
+    };
+  };
+}
+
+export interface AgentStatusMessage extends BaseMessage {
+  messageType: 'AGENT_STATUS';
+  agentId: string;
+  status: 'ONLINE' | 'OFFLINE' | 'BUSY' | 'ERROR';
+  version?: string;
+  capabilities?: string[];
+  metadata?: Record<string, any>;
+}
+
+export interface AgentHeartbeatMessage extends BaseMessage {
+  messageType: 'AGENT_HEARTBEAT';
+  agentId: string;
+  uptime: number;
+  memoryUsage?: {
+    rss: number;
+    heapTotal: number;
+    heapUsed: number;
+    external: number;
+  };
+  activeJobs: number;
+  completedJobs: number;
+  failedJobs: number;
+}
+
+export interface AgentLogMessage extends BaseMessage {
+  messageType: 'AGENT_LOG';
+  agentId: string;
+  level: 'debug' | 'info' | 'warn' | 'error';
+  message: string;
+  context?: string;
+  stack?: string;
+  metadata?: Record<string, any>;
+}
+
+export interface AgentMetricsMessage extends BaseMessage {
+  messageType: 'AGENT_METRICS';
+  agentId: string;
+  metrics: {
+    jobsProcessed: number;
+    averageProcessingTime: number;
+    errorRate: number;
+    memoryUsage: number;
+    cpuUsage?: number;
+    timestamp: string;
+  };
+}
+
+export type AgentMessage = 
+  | ScrapeRequestMessage
+  | ScrapeResponseMessage
+  | AgentStatusMessage
+  | AgentHeartbeatMessage
+  | AgentLogMessage
+  | AgentMetricsMessage;
+
+// Queue and routing key constants
+export const AGENT_QUEUES = {
+  SCRAPE_REQUESTS: 'agent.scrape.requests',
+  SCRAPE_RESPONSES: 'agent.scrape.responses',
+  AGENT_STATUS: 'agent.status',
+  AGENT_HEARTBEAT: 'agent.heartbeat',
+  AGENT_LOGS: 'agent.logs',
+  AGENT_METRICS: 'agent.metrics',
+  // Dead letter queues
+  SCRAPE_REQUESTS_DLQ: 'agent.scrape.requests.dlq',
+  SCRAPE_RESPONSES_DLQ: 'agent.scrape.responses.dlq',
+} as const;
+
+export const AGENT_ROUTING_KEYS = {
+  SCRAPE_REQUEST: 'agent.scrape.request',
+  SCRAPE_RESPONSE: 'agent.scrape.response',
+  AGENT_STATUS: 'agent.status',
+  AGENT_HEARTBEAT: 'agent.heartbeat',
+  AGENT_LOGS: 'agent.logs',
+  AGENT_METRICS: 'agent.metrics',
+} as const;
+
+export const AGENT_EXCHANGES = {
+  MAIN: 'agent.exchange',
+  DLX: 'agent.dlx.exchange',
+} as const;
