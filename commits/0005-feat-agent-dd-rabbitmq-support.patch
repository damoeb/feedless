+import { Module, DynamicModule, Global } from '@nestjs/common';
+import { ClientsModule, Transport } from '@nestjs/microservices';
+import { RabbitMQConfigService } from './rabbitmq-config.service';
+import { RabbitMQService } from './rabbitmq.service';
+import { RabbitMQProducerService } from './rabbitmq-producer.service';
+import { RabbitMQConsumerService } from './rabbitmq-consumer.service';
+import { CommonModule } from '../services/common/common.module';
+
+@Global()
+@Module({
+  imports: [CommonModule],
+  providers: [
+    RabbitMQConfigService,
+    RabbitMQService,
+    RabbitMQProducerService,
+    RabbitMQConsumerService,
+  ],
+  exports: [
+    RabbitMQConfigService,
+    RabbitMQService,
+    RabbitMQProducerService,
+    RabbitMQConsumerService,
+  ],
+})
+export class RabbitMQModule {
+  static forRoot(): DynamicModule {
+    return {
+      module: RabbitMQModule,
+      imports: [
+        ClientsModule.registerAsync([
+          {
+            name: 'RABBITMQ_SERVICE',
+            useFactory: (configService: RabbitMQConfigService) => {
+              const config = configService.getConnectionConfig();
+              return {
+                transport: Transport.RMQ,
+                options: {
+                  urls: [configService.getConnectionUrl()],
+                  queue: 'agent_queue',
+                  queueOptions: {
+                    durable: true,
+                  },
+                  socketOptions: {
+                    heartbeatIntervalInSeconds: config.heartbeat,
+                    reconnectTimeInSeconds: config.reconnectDelay / 1000,
+                  },
+                },
+              };
+            },
+            inject: [RabbitMQConfigService],
+          },
+        ]),
+      ],
+      providers: [
+        RabbitMQConfigService,
+        RabbitMQService,
+        RabbitMQProducerService,
+        RabbitMQConsumerService,
+      ],
+      exports: [
+        RabbitMQConfigService,
+        RabbitMQService,
+        RabbitMQProducerService,
+        RabbitMQConsumerService,
+      ],
+    };
+  }
+}
