@@ -0,0 +1,212 @@
+import { Injectable, Logger } from '@nestjs/common';
+import { RabbitMQService } from './rabbitmq.service';
+import { RabbitMQConfigService } from './rabbitmq-config.service';
+import {
+  AgentMessage,
+  ScrapeResponseMessage,
+  AgentStatusMessage,
+  AgentHeartbeatMessage,
+  AgentLogMessage,
+  AgentMetricsMessage,
+  AGENT_EXCHANGES,
+  AGENT_ROUTING_KEYS,
+} from './message.types';
+import { v4 as uuidv4 } from 'uuid';
+
+@Injectable()
+export class RabbitMQProducerService {
+  private readonly logger = new Logger(RabbitMQProducerService.name);
+  private agentId: string;
+
+  constructor(
+    private readonly rabbitMQService: RabbitMQService,
+    private readonly configService: RabbitMQConfigService,
+  ) {
+    this.agentId = this.configService.getAgentId();
+  }
+
+  async sendMessage<T extends AgentMessage>(
+    routingKey: string,
+    message: T,
+    options: {
+      priority?: number;
+      expiration?: number;
+      persistent?: boolean;
+    } = {},
+  ): Promise<void> {
+    if (!this.configService.isEnabled()) {
+      this.logger.debug('RabbitMQ disabled, skipping message send');
+      return;
+    }
+
+    try {
+      const channel = this.rabbitMQService.getPublisherChannel();
+      const publisherConfig = this.configService.getPublisherConfig();
+
+      const publishOptions = {
+        messageId: message.messageId,
+        timestamp: Date.now(),
+        persistent: options.persistent ?? publisherConfig.persistent,
+        priority: options.priority ?? 0,
+        expiration: options.expiration?.toString(),
+        headers: {
+          agentId: this.agentId,
+          messageType: message.messageType,
+        },
+      };
+
+      await channel.publish(
+        AGENT_EXCHANGES.MAIN,
+        routingKey,
+        message,
+        publishOptions,
+      );
+
+      this.logger.debug(
+        `Message sent: ${message.messageType} to ${routingKey}`,
+      );
+    } catch (error) {
+      this.logger.error(
+        `Failed to send message: ${message.messageType}`,
+        error,
+      );
+      throw error;
+    }
+  }
+
+  async sendScrapeResponse(
+    callbackId: string,
+    corrId: string,
+    scrapeResponse: any,
+  ): Promise<void> {
+    const message: ScrapeResponseMessage = {
+      messageId: uuidv4(),
+      timestamp: new Date().toISOString(),
+      messageType: 'SCRAPE_RESPONSE',
+      callbackId,
+      corrId,
+      scrapeResponse,
+    };
+
+    await this.sendMessage(AGENT_ROUTING_KEYS.SCRAPE_RESPONSE, message, {
+      priority: 5,
+    });
+  }
+
+  async sendAgentStatus(
+    status: 'ONLINE' | 'OFFLINE' | 'BUSY' | 'ERROR',
+    metadata?: Record<string, any>,
+  ): Promise<void> {
+    const message: AgentStatusMessage = {
+      messageId: uuidv4(),
+      timestamp: new Date().toISOString(),
+      messageType: 'AGENT_STATUS',
+      agentId: this.agentId,
+      status,
+      version: process.env.APP_VERSION || 'unknown',
+      capabilities: ['web-scraping', 'puppeteer'],
+      metadata,
+    };
+
+    await this.sendMessage(AGENT_ROUTING_KEYS.AGENT_STATUS, message);
+  }
+
+  async sendHeartbeat(
+    activeJobs: number,
+    completedJobs: number,
+    failedJobs: number,
+  ): Promise<void> {
+    const uptime = process.uptime();
+    const memoryUsage = process.memoryUsage();
+
+    const message: AgentHeartbeatMessage = {
+      messageId: uuidv4(),
+      timestamp: new Date().toISOString(),
+      messageType: 'AGENT_HEARTBEAT',
+      agentId: this.agentId,
+      uptime,
+      memoryUsage: {
+        rss: memoryUsage.rss,
+        heapTotal: memoryUsage.heapTotal,
+        heapUsed: memoryUsage.heapUsed,
+        external: memoryUsage.external,
+      },
+      activeJobs,
+      completedJobs,
+      failedJobs,
+    };
+
+    await this.sendMessage(AGENT_ROUTING_KEYS.AGENT_HEARTBEAT, message);
+  }
+
+  async sendLog(
+    level: 'debug' | 'info' | 'warn' | 'error',
+    message: string,
+    context?: string,
+    stack?: string,
+    metadata?: Record<string, any>,
+  ): Promise<void> {
+    const logMessage: AgentLogMessage = {
+      messageId: uuidv4(),
+      timestamp: new Date().toISOString(),
+      messageType: 'AGENT_LOG',
+      agentId: this.agentId,
+      level,
+      message,
+      context,
+      stack,
+      metadata,
+    };
+
+    await this.sendMessage(AGENT_ROUTING_KEYS.AGENT_LOGS, logMessage);
+  }
+
+  async sendMetrics(
+    jobsProcessed: number,
+    averageProcessingTime: number,
+    errorRate: number,
+  ): Promise<void> {
+    const memoryUsage = process.memoryUsage();
+
+    const message: AgentMetricsMessage = {
+      messageId: uuidv4(),
+      timestamp: new Date().toISOString(),
+      messageType: 'AGENT_METRICS',
+      agentId: this.agentId,
+      metrics: {
+        jobsProcessed,
+        averageProcessingTime,
+        errorRate,
+        memoryUsage: memoryUsage.heapUsed,
+        timestamp: new Date().toISOString(),
+      },
+    };
+
+    await this.sendMessage(AGENT_ROUTING_KEYS.AGENT_METRICS, message);
+  }
+
+  async sendCustomMessage(
+    routingKey: string,
+    payload: any,
+    messageType: string,
+    options?: {
+      priority?: number;
+      expiration?: number;
+      persistent?: boolean;
+    },
+  ): Promise<void> {
+    const message = {
+      messageId: uuidv4(),
+      timestamp: new Date().toISOString(),
+      messageType,
+      agentId: this.agentId,
+      payload,
+    };
+
+    await this.sendMessage(routingKey, message as any, options);
+  }
+
+  getAgentId(): string {
+    return this.agentId;
+  }
+}
