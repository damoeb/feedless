+/**
+ * Example usage of RabbitMQ integration in Feedless Agent
+ * 
+ * This file demonstrates how to:
+ * 1. Initialize RabbitMQ services
+ * 2. Send messages to the server
+ * 3. Handle incoming scrape requests
+ * 4. Monitor agent health and metrics
+ */
+
+import { Logger } from '@nestjs/common';
+import { RabbitMQProducerService } from './rabbitmq-producer.service';
+import { RabbitMQConsumerService } from './rabbitmq-consumer.service';
+import { ScrapeRequestMessage } from './message.types';
+
+export class RabbitMQExample {
+  private readonly logger = new Logger(RabbitMQExample.name);
+
+  constructor(
+    private readonly producer: RabbitMQProducerService,
+    private readonly consumer: RabbitMQConsumerService,
+  ) {}
+
+  async initialize() {
+    this.logger.log('Initializing RabbitMQ Example');
+
+    // Register a custom scrape request handler
+    this.consumer.registerScrapeRequestHandler(this.handleScrapeRequest.bind(this));
+
+    // Send initial agent status
+    await this.producer.sendAgentStatus('ONLINE', {
+      example: 'This is an example agent',
+      capabilities: ['web-scraping', 'custom-processing'],
+    });
+
+    // Start sending periodic heartbeats
+    this.startHeartbeatExample();
+
+    // Start sending periodic metrics
+    this.startMetricsExample();
+
+    this.logger.log('RabbitMQ Example initialized');
+  }
+
+  /**
+   * Example scrape request handler
+   */
+  private async handleScrapeRequest(message: ScrapeRequestMessage): Promise<any> {
+    this.logger.log(`Handling scrape request: ${message.callbackId}`);
+    this.logger.debug(`Scrape URL: ${message.scrapeRequest.url}`);
+
+    try {
+      // Simulate scraping process
+      const startTime = Date.now();
+      
+      // Send status update
+      await this.producer.sendAgentStatus('BUSY', {
+        processingJob: message.callbackId,
+        url: message.scrapeRequest.url,
+      });
+
+      // Simulate processing time based on priority
+      const processingTime = message.priority ? (6 - message.priority) * 1000 : 3000;
+      await this.sleep(processingTime);
+
+      // Simulate different outcomes based on URL
+      if (message.scrapeRequest.url.includes('error')) {
+        throw new Error('Simulated scraping error');
+      }
+
+      // Create mock response
+      const scrapeResponse = {
+        ok: true,
+        url: message.scrapeRequest.url,
+        outputs: [
+          {
+            type: 'text',
+            selector: 'title',
+            value: `Example Title for ${message.scrapeRequest.url}`,
+          },
+          {
+            type: 'text',
+            selector: 'meta[name="description"]',
+            value: 'Example description content',
+          },
+          {
+            type: 'link',
+            selector: 'a[href]',
+            value: 'https://example.com/link',
+          },
+        ],
+        logs: [
+          `Started processing: ${message.scrapeRequest.url}`,
+          `Processing took: ${Date.now() - startTime}ms`,
+          'Scraping completed successfully',
+        ],
+        debug: {
+          corrId: message.corrId || '',
+          console: ['Example console log'],
+          cookies: [],
+          statusCode: 200,
+          metrics: {
+            render: Date.now() - startTime,
+            queue: 100,
+          },
+          network: [
+            {
+              url: message.scrapeRequest.url,
+              method: 'GET',
+              status: 200,
+              responseTime: 500,
+            },
+          ],
+          prerendered: true,
+        },
+      };
+
+      // Send status back to online
+      await this.producer.sendAgentStatus('ONLINE');
+
+      this.logger.log(`Successfully processed scrape request: ${message.callbackId}`);
+      return scrapeResponse;
+
+    } catch (error) {
+      this.logger.error(`Failed to process scrape request: ${message.callbackId}`, error);
+
+      // Send error status
+      await this.producer.sendAgentStatus('ERROR', {
+        error: error.message,
+        job: message.callbackId,
+      });
+
+      // Send error log
+      await this.producer.sendLog(
+        'error',
+        `Scrape request failed: ${error.message}`,
+        'RabbitMQExample',
+        error.stack,
+        {
+          callbackId: message.callbackId,
+          url: message.scrapeRequest.url,
+        },
+      );
+
+      // Return error response
+      return {
+        ok: false,
+        errorMessage: error.message,
+        outputs: [],
+        logs: [error.message],
+      };
+    }
+  }
+
+  /**
+   * Example heartbeat sender
+   */
+  private startHeartbeatExample() {
+    let completedJobs = 0;
+    let failedJobs = 0;
+
+    setInterval(async () => {
+      try {
+        // Simulate job completion
+        if (Math.random() > 0.7) {
+          completedJobs++;
+        }
+        if (Math.random() > 0.9) {
+          failedJobs++;
+        }
+
+        await this.producer.sendHeartbeat(
+          Math.floor(Math.random() * 3), // activeJobs: 0-2
+          completedJobs,
+          failedJobs,
+        );
+
+        this.logger.debug('Heartbeat sent');
+      } catch (error) {
+        this.logger.error('Failed to send heartbeat', error);
+      }
+    }, 30000); // Every 30 seconds
+  }
+
+  /**
+   * Example metrics sender
+   */
+  private startMetricsExample() {
+    let totalJobs = 0;
+    const processingTimes: number[] = [];
+
+    setInterval(async () => {
+      try {
+        // Simulate metrics
+        totalJobs += Math.floor(Math.random() * 5);
+        const newProcessingTime = 1000 + Math.random() * 2000; // 1-3 seconds
+        processingTimes.push(newProcessingTime);
+
+        // Keep only last 100 processing times
+        if (processingTimes.length > 100) {
+          processingTimes.splice(0, processingTimes.length - 100);
+        }
+
+        const averageProcessingTime = processingTimes.reduce((a, b) => a + b, 0) / processingTimes.length;
+        const errorRate = Math.random() * 0.1; // 0-10% error rate
+
+        await this.producer.sendMetrics(
+          totalJobs,
+          averageProcessingTime,
+          errorRate,
+        );
+
+        this.logger.debug('Metrics sent', {
+          totalJobs,
+          averageProcessingTime: Math.round(averageProcessingTime),
+          errorRate: Math.round(errorRate * 100) / 100,
+        });
+      } catch (error) {
+        this.logger.error('Failed to send metrics', error);
+      }
+    }, 60000); // Every minute
+  }
+
+  /**
+   * Example of sending custom messages
+   */
+  async sendCustomMessage() {
+    await this.producer.sendCustomMessage(
+      'custom.routing.key',
+      {
+        customData: 'This is a custom message',
+        timestamp: new Date().toISOString(),
+        agentInfo: {
+          id: this.producer.getAgentId(),
+          version: '1.0.0',
+        },
+      },
+      'CUSTOM_MESSAGE',
+      {
+        priority: 7,
+        persistent: true,
+      },
+    );
+
+    this.logger.log('Custom message sent');
+  }
+
+  /**
+   * Example of sending logs with different levels
+   */
+  async sendExampleLogs() {
+    await this.producer.sendLog('info', 'Agent started successfully', 'RabbitMQExample');
+    
+    await this.producer.sendLog(
+      'warn',
+      'High memory usage detected',
+      'RabbitMQExample',
+      undefined,
+      { memoryUsage: process.memoryUsage() },
+    );
+
+    await this.producer.sendLog(
+      'error',
+      'Example error occurred',
+      'RabbitMQExample',
+      new Error('Example error').stack,
+      { errorCode: 'EXAMPLE_001' },
+    );
+
+    this.logger.log('Example logs sent');
+  }
+
+  /**
+   * Utility method for simulating async operations
+   */
+  private sleep(ms: number): Promise<void> {
+    return new Promise(resolve => setTimeout(resolve, ms));
+  }
+
+  /**
+   * Cleanup method
+   */
+  async shutdown() {
+    this.logger.log('Shutting down RabbitMQ Example');
+    
+    // Send offline status
+    await this.producer.sendAgentStatus('OFFLINE', {
+      reason: 'Example shutdown',
+    });
+
+    // Unregister handler
+    this.consumer.unregisterScrapeRequestHandler();
+
+    this.logger.log('RabbitMQ Example shutdown complete');
+  }
+}
+
+/**
+ * Example usage in a NestJS service
+ */
+/*
+@Injectable()
+export class ExampleService implements OnModuleInit, OnModuleDestroy {
+  private example: RabbitMQExample;
+
+  constructor(
+    private producer: RabbitMQProducerService,
+    private consumer: RabbitMQConsumerService,
+  ) {
+    this.example = new RabbitMQExample(producer, consumer);
+  }
+
+  async onModuleInit() {
+    await this.example.initialize();
+  }
+
+  async onModuleDestroy() {
+    await this.example.shutdown();
+  }
+
+  async sendCustomMessage() {
+    await this.example.sendCustomMessage();
+  }
+
+  async sendExampleLogs() {
+    await this.example.sendExampleLogs();
+  }
+}
+*/
diff --git a/packages/agent/src/messaging/message.types.ts b/packages/agent/src/messaging/message.types.ts
