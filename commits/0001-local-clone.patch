+  /**
+   * Creates metadata file for the cloned repository
+   */
+  private fun createMetadata(repoUrl: String, shallow: Boolean) {
+    val now = Instant.now().toString()
+    val metadata = RepositoryMetadata(
+      repoUrl = repoUrl,
+      createdAt = now,
+      lastUsed = now,
+      shallow = shallow
+    )
+    writeMetadata(metadata)
+  }
+
+  /**
+   * Updates the lastUsed timestamp in the metadata file
+   */
+  private fun updateLastUsedTimestamp() {
+    val metadata = readMetadata()
+    if (metadata != null) {
+      metadata.lastUsed = Instant.now().toString()
+      writeMetadata(metadata)
+    }
   }
 
+  /**
+   * Reads metadata from the metadata file in the container directory
+   */
+  private fun readMetadata(): RepositoryMetadata? {
+    val metadataFile = File(containerDir, METADATA_FILENAME)
+    return if (metadataFile.exists()) {
+      try {
+        gson.fromJson(metadataFile.readText(), RepositoryMetadata::class.java)
+      } catch (e: Exception) {
+        null
+      }
+    } else {
+      null
+    }
+  }
+
+  /**
+   * Writes metadata to the metadata file in the container directory (outside the repo)
+   */
+  private fun writeMetadata(metadata: RepositoryMetadata) {
+    val metadataFile = File(containerDir, METADATA_FILENAME)
+    metadataFile.writeText(gson.toJson(metadata))
+    
+    // Apply security permissions to metadata file
+    try {
+      Files.setPosixFilePermissions(metadataFile.toPath(), SECURE_FILE_PERMISSIONS)
+    } catch (e: UnsupportedOperationException) {
+      metadataFile.setReadable(true, true)
+      metadataFile.setWritable(true, true)
+      metadataFile.setExecutable(false, false)
+    }
+  }
+
+  /**
+   * Gets the metadata for this repository
+   * Public method for external access to metadata
+   */
+  fun getMetadata(): RepositoryMetadata? {
+    return readMetadata()
+  }
+
+  /**
+   * Applies security measures to the container directory.
+   * Setting permissions on the container directory (700) restricts access from group and other users.
+   * This is sufficient for security as only the owner can traverse into the directory.
+   */
+  private fun applySecurityMeasures() {
+    try {
+      // Set container directory to 700 (rwx for owner only)
+      // This prevents group and other from accessing any files within (including repo and metadata)
+      Files.setPosixFilePermissions(containerDir.toPath(), SECURE_DIR_PERMISSIONS)
+    } catch (e: UnsupportedOperationException) {
+      // POSIX permissions not supported on this file system (e.g., Windows)
+      // Fall back to basic Java file permissions
+      containerDir.setReadable(true, true)    // Readable by owner only
+      containerDir.setWritable(true, true)    // Writable by owner only
+      containerDir.setExecutable(true, true)  // Executable by owner only (needed for traversal)
+    }
+  }
 }
