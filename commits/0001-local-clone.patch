+    private val SECURE_DIR_PERMISSIONS = setOf(
+      PosixFilePermission.OWNER_READ,
+      PosixFilePermission.OWNER_WRITE,
+      PosixFilePermission.OWNER_EXECUTE
+    )
+
+    /**
+     * File permissions: owner read+write only (600)
+     * No execute permission - files are not executable
+     * Group and other have no permissions
+     */
+    private val SECURE_FILE_PERMISSIONS = setOf(
+      PosixFilePermission.OWNER_READ,
+      PosixFilePermission.OWNER_WRITE
+    )
+
+    /**
+     * Utility method to find old clones that haven't been used recently
+     * @param baseDirectory the directory to search for git clones (e.g., temp directory)
+     * @param olderThanDays consider clones older than this many days for cleanup
+     * @return list of directories that are candidates for cleanup
+     */
+    fun findOldClones(baseDirectory: File, olderThanDays: Int): List<Pair<File, RepositoryMetadata>> {
+      val cutoffTime = Instant.now().minusSeconds((olderThanDays * 24 * 60 * 60).toLong())
+      val oldClones = mutableListOf<Pair<File, RepositoryMetadata>>()
+
+      if (!baseDirectory.exists() || !baseDirectory.isDirectory) {
+        return oldClones
+      }
+
+      baseDirectory.listFiles()?.forEach { dir ->
+        if (dir.isDirectory) {
+          val metadataFile = File(dir, METADATA_FILENAME)
+          if (metadataFile.exists()) {
+            try {
+              val metadata = gson.fromJson(metadataFile.readText(), RepositoryMetadata::class.java)
+              val lastUsed = Instant.parse(metadata.lastUsed)
+              
+              if (lastUsed.isBefore(cutoffTime)) {
+                oldClones.add(Pair(dir, metadata))
+              }
+            } catch (e: Exception) {
+              // Ignore directories with invalid metadata
+            }
+          }
+        }
+      }
+
+      return oldClones
+    }
   }
 
