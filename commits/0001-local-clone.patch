+      }
+
+      if (shallow) {
+        cloneCommand.setDepth(1)
+      }
+
+      val git = cloneCommand.call()
+      
+      // Apply security measures to container directory
+      val instance = LocalGitRepositoryImpl(containerDir, git, gitConnectionCapability)
+      instance.applySecurityMeasures()
+      
+      // Create metadata file in container (not in repo)
+      instance.createMetadata(repoUrl, shallow)
+
+      return instance
+    }
 
