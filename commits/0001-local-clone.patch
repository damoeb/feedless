+  @Test
+  fun `test capability serialization and deserialization`() {
+    val repoUrl = "https://github.com/octocat/Hello-World.git"
+    val githubCapability = GithubCapability("")
+    val accountConfig = GithubAccountConfig(githubCapability)
+    val gitConnectionCapability = GitConnectionCapability(accountConfig)
+
+    // Clone the repository
+    val repo = LocalGitRepositoryImpl.clone(
+      repoUrl = repoUrl,
+      token = null,
+      shallow = true,
+      gitConnectionCapability = gitConnectionCapability
+    ) as LocalGitRepositoryImpl
+
+    repositoriesToCleanup.add(repo)
+
+    // Get capability
+    val capability = repo.capability()
+    val capabilityData = capability.capabilityPayload
+
+    // Recreate from capability multiple times to ensure it's reusable
+    val repo2 = LocalGitRepositoryImpl(capabilityData) as LocalGitRepositoryImpl
+    val repo3 = LocalGitRepositoryImpl(capabilityData) as LocalGitRepositoryImpl
+
+    repositoriesToCleanup.add(repo2)
+    repositoriesToCleanup.add(repo3)
+
+    // All should be able to list files
+    val files1 = repo.files()
+    val files2 = repo2.files()
+    val files3 = repo3.files()
+
+    assertThat(files1.size).isEqualTo(files2.size)
+    assertThat(files2.size).isEqualTo(files3.size)
+  }
