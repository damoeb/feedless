+class LocalGitRepositoryImplTest {
+
+  private val repositoriesToCleanup = mutableListOf<LocalGitRepositoryImpl>()
+
+  @AfterEach
+  fun cleanup() {
+    // Clean up cloned repositories
+    repositoriesToCleanup.forEach { repo ->
+      try {
+        repo.close()
+        val capability = repo.capability()
+        capability.capabilityPayload.directory.deleteRecursively()
+      } catch (e: Exception) {
+        // Ignore cleanup errors
+      }
+    }
+    repositoriesToCleanup.clear()
+  }
+
+  @Test
+  fun `test repository structure with repo subfolder and metadata at container level`() {
+    // Step 1: Clone a public GitHub repository
+    val repoUrl = "https://github.com/octocat/Hello-World.git"
+    val githubCapability = GithubCapability("")
+    val accountConfig = GithubAccountConfig(githubCapability)
+    val gitConnectionCapability = GitConnectionCapability(accountConfig)
+
+    // Step 2: Perform shallow clone
+    val repo = LocalGitRepositoryImpl.clone(
+      repoUrl = repoUrl,
+      token = null,
+      shallow = true,
+      gitConnectionCapability = gitConnectionCapability
+    ) as LocalGitRepositoryImpl
+
+    repositoriesToCleanup.add(repo)
+
+    // Step 3: Verify structure
+    val capability = repo.capability()
+    val containerDir = capability.capabilityPayload.directory
+    
+    assertThat(containerDir).exists()
+    assertThat(containerDir.isDirectory).isTrue()
+
+    // Verify repo subfolder exists
+    val repoDir = File(containerDir, "repo")
+    assertThat(repoDir).exists()
+    assertThat(repoDir.isDirectory).isTrue()
+    
+    // Verify .git folder is inside repo subfolder
+    val gitDir = File(repoDir, ".git")
+    assertThat(gitDir).exists()
+    assertThat(gitDir.isDirectory).isTrue()
+
+    // Verify metadata is at container level (not inside repo)
+    val metadataFile = File(containerDir, ".feedless-metadata.json")
+    assertThat(metadataFile).exists()
+    assertThat(metadataFile.isFile).isTrue()
+    
+    // Verify metadata is NOT inside repo folder
+    val wrongMetadataLocation = File(repoDir, ".feedless-metadata.json")
+    assertThat(wrongMetadataLocation).doesNotExist()
+
+    println("Structure verified:")
+    println("  Container: ${containerDir.name}/")
+    println("    ├── .feedless-metadata.json ✓")
+    println("    └── repo/ ✓")
+    println("        └── .git/ ✓")
+  }
+
+  @Test
+  fun `test shallow clone public repository, get capability, recreate and list files`() {
+    // Step 1: Clone a public GitHub repository
+    val repoUrl = "https://github.com/octocat/Hello-World.git"
+    val githubCapability = GithubCapability("")
+    val accountConfig = GithubAccountConfig(githubCapability)
+    val gitConnectionCapability = GitConnectionCapability(accountConfig)
+
+    // Step 2: Perform shallow clone
+    val originalRepo = LocalGitRepositoryImpl.clone(
+      repoUrl = repoUrl,
+      token = null,
+      shallow = true,
+      gitConnectionCapability = gitConnectionCapability
+    ) as LocalGitRepositoryImpl
+
+    repositoriesToCleanup.add(originalRepo)
+
+    // Verify the clone was successful
+    assertThat(originalRepo).isNotNull
+    val originalCapability = originalRepo.capability()
+    assertThat(originalCapability).isNotNull
+    assertThat(originalCapability.capabilityPayload.directory).exists()
+    assertThat(originalCapability.capabilityPayload.directory.isDirectory).isTrue()
+
+    // Step 3: Get the capability
+    val capability = originalCapability.capabilityPayload
+
+    // Verify the capability contains the git connection capability
+    assertThat(capability.gitConnectionCapability).isEqualTo(gitConnectionCapability)
+    assertThat(capability.directory).exists()
+
+    // Step 4: Recreate the LocalGitRepository using the capability
+    val recreatedRepo = LocalGitRepositoryImpl(capability) as LocalGitRepositoryImpl
+    repositoriesToCleanup.add(recreatedRepo)
+
+    // Verify the recreated repository
+    assertThat(recreatedRepo).isNotNull
+
+    // Step 5: List files from the recreated repository
+    val files = recreatedRepo.files()
+    assertThat(files).isNotEmpty
+    
+    // The Hello-World repository typically contains a README file
+    assertThat(files.size).isGreaterThan(0)
+    
+    println("Successfully cloned and listed ${files.size} files from the repository")
+
+    // Verify we can get the capability from the recreated repo too
+    val recreatedCapability = recreatedRepo.capability()
+    assertThat(recreatedCapability.capabilityPayload.directory).isEqualTo(capability.directory)
+  }
