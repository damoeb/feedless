+    /**
+     * Static factory method to clone a repository
+     * @param repoUrl the URL of the git repository
+     * @param token the authentication token (optional for public repos)
+     * @param shallow if true, performs a shallow clone (depth=1)
+     * @param gitConnectionCapability the git connection capability for future operations
+     * @return a LocalGitRepository instance
+     */
+    fun clone(
+      repoUrl: String,
+      token: String? = null,
+      shallow: Boolean = false,
+      gitConnectionCapability: GitConnectionCapability
+    ): LocalGitRepository {
+      // Create container directory with restricted permissions (owner rwx only)
+      // Structure:
+      //   /tmp/git-repo-xxxxx/           <- container (metadata here)
+      //   └── repo/                       <- actual git repository
+      val dirPermissions = PosixFilePermissions.asFileAttribute(
+        setOf(
