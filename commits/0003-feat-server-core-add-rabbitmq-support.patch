+        assertNotNull(queueProperties, "Feed processing queue should exist")
+        log.info("Queue properties: {}", queueProperties)
+        
+        val dlqProperties = rabbitAdmin.getQueueProperties(RabbitMQConfig.FEED_PROCESSING_DLQ)
+        assertNotNull(dlqProperties, "Feed processing DLQ should exist")
+    }
+
+    @Test
