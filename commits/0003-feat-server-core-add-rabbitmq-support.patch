+            feedUrl = "https://example.com/feed.xml",
+            repositoryId = "test-repo-456",
+            priority = 5
+        )
+
+        // Send message
+        assertDoesNotThrow {
+            messageProducer.sendFeedProcessingMessage(message)
+        }
+
+        // Verify message was sent (basic verification)
