+package org.migor.feedless.message
+
+import org.migor.feedless.config.RabbitMQConfig
+import org.slf4j.LoggerFactory
+import org.springframework.amqp.core.Message
+import org.springframework.amqp.core.MessageProperties
+import org.springframework.amqp.rabbit.core.RabbitTemplate
+import org.springframework.beans.factory.annotation.Autowired
+import org.springframework.context.annotation.Profile
+import org.springframework.stereotype.Service
+import java.time.LocalDateTime
+
+/**
+ * Service for producing messages to RabbitMQ queues
+ */
+@Service
+@Profile("!test")
+class RabbitMessageProducer @Autowired constructor(
+    private val rabbitTemplate: RabbitTemplate
+) {
+
+    private val log = LoggerFactory.getLogger(RabbitMessageProducer::class.java)
+
+    /**
+     * Send feed processing message
+     */
+    fun sendFeedProcessingMessage(message: FeedProcessingMessage) {
+        try {
+            log.debug("Sending feed processing message for feed: {}", message.feedId)
+            rabbitTemplate.convertAndSend(
+                RabbitMQConfig.FEEDLESS_EXCHANGE,
+                RabbitMQConfig.FEED_PROCESSING_ROUTING_KEY,
+                message
+            ) { msg ->
+                msg.messageProperties.priority = message.priority
+                msg.messageProperties.timestamp = java.util.Date()
+                msg.messageProperties.messageId = message.messageId
+                msg
+            }
+            log.info("Feed processing message sent successfully for feed: {}", message.feedId)
+        } catch (e: Exception) {
+            log.error("Failed to send feed processing message for feed: {}", message.feedId, e)
+            throw e
+        }
+    }
+
+    /**
+     * Send document processing message
+     */
+    fun sendDocumentProcessingMessage(message: DocumentProcessingMessage) {
+        try {
+            log.debug("Sending document processing message for document: {}", message.documentId)
+            rabbitTemplate.convertAndSend(
+                RabbitMQConfig.FEEDLESS_EXCHANGE,
+                RabbitMQConfig.DOCUMENT_PROCESSING_ROUTING_KEY,
+                message
+            ) { msg ->
+                msg.messageProperties.priority = message.priority
+                msg.messageProperties.timestamp = java.util.Date()
+                msg.messageProperties.messageId = message.messageId
+                msg
+            }
+            log.info("Document processing message sent successfully for document: {}", message.documentId)
+        } catch (e: Exception) {
+            log.error("Failed to send document processing message for document: {}", message.documentId, e)
+            throw e
+        }
+    }
+
+    /**
+     * Send notification message
+     */
+    fun sendNotificationMessage(message: NotificationMessage) {
+        try {
+            log.debug("Sending notification message for user: {}", message.userId)
+            rabbitTemplate.convertAndSend(
+                RabbitMQConfig.FEEDLESS_EXCHANGE,
+                RabbitMQConfig.NOTIFICATION_ROUTING_KEY,
+                message
+            ) { msg ->
+                msg.messageProperties.timestamp = java.util.Date()
+                msg.messageProperties.messageId = message.messageId
+                msg
+            }
+            log.info("Notification message sent successfully for user: {}", message.userId)
+        } catch (e: Exception) {
+            log.error("Failed to send notification message for user: {}", message.userId, e)
+            throw e
+        }
+    }
+
+    /**
+     * Send analytics message
+     */
+    fun sendAnalyticsMessage(message: AnalyticsMessage) {
+        try {
+            log.debug("Sending analytics message for event: {}", message.eventType)
+            rabbitTemplate.convertAndSend(
+                RabbitMQConfig.FEEDLESS_EXCHANGE,
+                RabbitMQConfig.ANALYTICS_ROUTING_KEY,
+                message
+            ) { msg ->
+                msg.messageProperties.timestamp = java.util.Date()
+                msg.messageProperties.messageId = message.messageId
+                msg
+            }
+            log.debug("Analytics message sent successfully for event: {}", message.eventType)
+        } catch (e: Exception) {
+            log.error("Failed to send analytics message for event: {}", message.eventType, e)
+            throw e
+        }
+    }
+
+    /**
+     * Send a message with custom routing key
+     */
+    fun sendMessage(routingKey: String, message: RabbitMessageDTO, priority: Int = 0) {
+        try {
+            log.debug("Sending message with routing key: {}", routingKey)
+            rabbitTemplate.convertAndSend(
+                RabbitMQConfig.FEEDLESS_EXCHANGE,
+                routingKey,
+                message
+            ) { msg ->
+                msg.messageProperties.priority = priority
+                msg.messageProperties.timestamp = java.util.Date()
+                msg.messageProperties.messageId = message.messageId
+                msg
+            }
+            log.info("Message sent successfully with routing key: {}", routingKey)
+        } catch (e: Exception) {
+            log.error("Failed to send message with routing key: {}", routingKey, e)
+            throw e
+        }
+    }
+
+    /**
+     * Send delayed message (requires RabbitMQ delayed message plugin)
+     */
+    fun sendDelayedMessage(routingKey: String, message: RabbitMessageDTO, delayMillis: Long) {
+        try {
+            log.debug("Sending delayed message with routing key: {}, delay: {}ms", routingKey, delayMillis)
+            rabbitTemplate.convertAndSend(
+                RabbitMQConfig.FEEDLESS_EXCHANGE,
+                routingKey,
+                message
+            ) { msg ->
+                msg.messageProperties.setHeader("x-delay", delayMillis)
+                msg.messageProperties.timestamp = java.util.Date()
+                msg.messageProperties.messageId = message.messageId
+                msg
+            }
+            log.info("Delayed message sent successfully with routing key: {}, delay: {}ms", routingKey, delayMillis)
+        } catch (e: Exception) {
+            log.error("Failed to send delayed message with routing key: {}, delay: {}ms", routingKey, delayMillis, e)
+            throw e
+        }
+    }
+}
