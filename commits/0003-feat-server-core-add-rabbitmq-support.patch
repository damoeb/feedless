+package org.migor.feedless.config
+
+import org.slf4j.LoggerFactory
+import org.springframework.amqp.core.*
+import org.springframework.amqp.rabbit.annotation.EnableRabbit
+import org.springframework.amqp.rabbit.config.SimpleRabbitListenerContainerFactory
+import org.springframework.amqp.rabbit.connection.ConnectionFactory
+import org.springframework.amqp.rabbit.core.RabbitAdmin
+import org.springframework.amqp.rabbit.core.RabbitTemplate
+import org.springframework.amqp.support.converter.Jackson2JsonMessageConverter
+import org.springframework.amqp.support.converter.MessageConverter
+import org.springframework.context.annotation.Bean
+import org.springframework.context.annotation.Configuration
+import org.springframework.context.annotation.Profile
+
+/**
+ * RabbitMQ Configuration for Feedless
+ * 
+ * This configuration sets up:
+ * - Message converter for JSON serialization
+ * - RabbitTemplate for sending messages
+ * - RabbitAdmin for queue management
+ * - Default exchanges and queues for common use cases
+ */
+@Configuration
+@EnableRabbit
+@Profile("!test")
+class RabbitMQConfig {
+
+    private val log = LoggerFactory.getLogger(RabbitMQConfig::class.java)
+
+    companion object {
+        // Exchange names
+        const val FEEDLESS_EXCHANGE = "feedless.exchange"
+        const val FEEDLESS_DLX_EXCHANGE = "feedless.dlx.exchange"
+        
+        // Queue names
+        const val FEED_PROCESSING_QUEUE = "feedless.feed.processing"
+        const val DOCUMENT_PROCESSING_QUEUE = "feedless.document.processing"
+        const val NOTIFICATION_QUEUE = "feedless.notification"
+        const val ANALYTICS_QUEUE = "feedless.analytics"
+        
+        // Dead letter queues
+        const val FEED_PROCESSING_DLQ = "feedless.feed.processing.dlq"
+        const val DOCUMENT_PROCESSING_DLQ = "feedless.document.processing.dlq"
+        const val NOTIFICATION_DLQ = "feedless.notification.dlq"
+        const val ANALYTICS_DLQ = "feedless.analytics.dlq"
+        
+        // Routing keys
+        const val FEED_PROCESSING_ROUTING_KEY = "feed.processing"
+        const val DOCUMENT_PROCESSING_ROUTING_KEY = "document.processing"
+        const val NOTIFICATION_ROUTING_KEY = "notification"
+        const val ANALYTICS_ROUTING_KEY = "analytics"
+    }
+
+    @Bean
+    fun messageConverter(): MessageConverter {
+        return Jackson2JsonMessageConverter()
+    }
+
+    @Bean
+    fun rabbitTemplate(connectionFactory: ConnectionFactory): RabbitTemplate {
+        val template = RabbitTemplate(connectionFactory)
+        template.messageConverter = messageConverter()
+        template.setConfirmCallback { correlationData, ack, cause ->
+            if (ack) {
+                log.debug("Message sent successfully: {}", correlationData?.id)
+            } else {
+                log.error("Message failed to send: {}, cause: {}", correlationData?.id, cause)
+            }
+        }
+        template.setMandatory(true)
+        template.setReturnsCallback { returned ->
+            log.error("Message returned: {}", returned.message)
+        }
+        return template
+    }
+
+    @Bean
+    fun rabbitAdmin(connectionFactory: ConnectionFactory): RabbitAdmin {
+        return RabbitAdmin(connectionFactory)
+    }
+
+    @Bean
+    fun rabbitListenerContainerFactory(connectionFactory: ConnectionFactory): SimpleRabbitListenerContainerFactory {
+        val factory = SimpleRabbitListenerContainerFactory()
+        factory.setConnectionFactory(connectionFactory)
+        factory.setMessageConverter(messageConverter())
+        factory.setDefaultRequeueRejected(false)
+        factory.setErrorHandler { exception ->
+            log.error("Error in rabbit listener", exception)
+        }
+        return factory
+    }
+
+    // Main exchange
+    @Bean
+    fun feedlessExchange(): TopicExchange {
+        return ExchangeBuilder
+            .topicExchange(FEEDLESS_EXCHANGE)
+            .durable(true)
+            .build()
+    }
+
+    // Dead letter exchange
+    @Bean
+    fun feedlessDlxExchange(): TopicExchange {
+        return ExchangeBuilder
+            .topicExchange(FEEDLESS_DLX_EXCHANGE)
+            .durable(true)
+            .build()
+    }
+
+    // Feed processing queue
+    @Bean
+    fun feedProcessingQueue(): Queue {
+        return QueueBuilder
+            .durable(FEED_PROCESSING_QUEUE)
+            .withArgument("x-dead-letter-exchange", FEEDLESS_DLX_EXCHANGE)
+            .withArgument("x-dead-letter-routing-key", "$FEED_PROCESSING_ROUTING_KEY.dlq")
+            .build()
+    }
+
+    @Bean
+    fun feedProcessingBinding(): Binding {
+        return BindingBuilder
+            .bind(feedProcessingQueue())
+            .to(feedlessExchange())
+            .with(FEED_PROCESSING_ROUTING_KEY)
+    }
+
+    @Bean
+    fun feedProcessingDlq(): Queue {
+        return QueueBuilder
+            .durable(FEED_PROCESSING_DLQ)
+            .build()
+    }
+
+    @Bean
+    fun feedProcessingDlqBinding(): Binding {
+        return BindingBuilder
+            .bind(feedProcessingDlq())
+            .to(feedlessDlxExchange())
+            .with("$FEED_PROCESSING_ROUTING_KEY.dlq")
+    }
+
+    // Document processing queue
+    @Bean
+    fun documentProcessingQueue(): Queue {
+        return QueueBuilder
+            .durable(DOCUMENT_PROCESSING_QUEUE)
+            .withArgument("x-dead-letter-exchange", FEEDLESS_DLX_EXCHANGE)
+            .withArgument("x-dead-letter-routing-key", "$DOCUMENT_PROCESSING_ROUTING_KEY.dlq")
+            .build()
+    }
+
+    @Bean
+    fun documentProcessingBinding(): Binding {
+        return BindingBuilder
+            .bind(documentProcessingQueue())
+            .to(feedlessExchange())
+            .with(DOCUMENT_PROCESSING_ROUTING_KEY)
+    }
+
+    @Bean
+    fun documentProcessingDlq(): Queue {
+        return QueueBuilder
+            .durable(DOCUMENT_PROCESSING_DLQ)
+            .build()
+    }
+
+    @Bean
+    fun documentProcessingDlqBinding(): Binding {
+        return BindingBuilder
+            .bind(documentProcessingDlq())
+            .to(feedlessDlxExchange())
+            .with("$DOCUMENT_PROCESSING_ROUTING_KEY.dlq")
+    }
+
+    // Notification queue
+    @Bean
+    fun notificationQueue(): Queue {
+        return QueueBuilder
+            .durable(NOTIFICATION_QUEUE)
+            .withArgument("x-dead-letter-exchange", FEEDLESS_DLX_EXCHANGE)
+            .withArgument("x-dead-letter-routing-key", "$NOTIFICATION_ROUTING_KEY.dlq")
+            .build()
+    }
+
+    @Bean
+    fun notificationBinding(): Binding {
+        return BindingBuilder
+            .bind(notificationQueue())
+            .to(feedlessExchange())
+            .with(NOTIFICATION_ROUTING_KEY)
+    }
+
+    @Bean
+    fun notificationDlq(): Queue {
+        return QueueBuilder
+            .durable(NOTIFICATION_DLQ)
+            .build()
+    }
+
+    @Bean
+    fun notificationDlqBinding(): Binding {
+        return BindingBuilder
+            .bind(notificationDlq())
+            .to(feedlessDlxExchange())
+            .with("$NOTIFICATION_ROUTING_KEY.dlq")
+    }
+
+    // Analytics queue
+    @Bean
+    fun analyticsQueue(): Queue {
+        return QueueBuilder
+            .durable(ANALYTICS_QUEUE)
+            .withArgument("x-dead-letter-exchange", FEEDLESS_DLX_EXCHANGE)
+            .withArgument("x-dead-letter-routing-key", "$ANALYTICS_ROUTING_KEY.dlq")
+            .build()
+    }
+
+    @Bean
+    fun analyticsBinding(): Binding {
+        return BindingBuilder
+            .bind(analyticsQueue())
+            .to(feedlessExchange())
+            .with(ANALYTICS_ROUTING_KEY)
+    }
+
+    @Bean
+    fun analyticsDlq(): Queue {
+        return QueueBuilder
+            .durable(ANALYTICS_DLQ)
+            .build()
+    }
+
+    @Bean
+    fun analyticsDlqBinding(): Binding {
+        return BindingBuilder
+            .bind(analyticsDlq())
+            .to(feedlessDlxExchange())
+            .with("$ANALYTICS_ROUTING_KEY.dlq")
+    }
+}
