+package org.migor.feedless.message
+
+import org.slf4j.LoggerFactory
+import org.springframework.beans.factory.annotation.Autowired
+import org.springframework.context.annotation.Profile
+import org.springframework.stereotype.Service
+
+/**
+ * High-level service for RabbitMQ messaging operations
+ * This service provides convenient methods for common messaging patterns
+ */
+@Service
+@Profile("!test")
+class RabbitMessageService @Autowired constructor(
+    private val messageProducer: RabbitMessageProducer
+) {
+
+    private val log = LoggerFactory.getLogger(RabbitMessageService::class.java)
+
+    /**
+     * Schedule feed processing for a given feed
+     */
+    fun scheduleFeedProcessing(feedId: String, feedUrl: String, repositoryId: String? = null, priority: Int = 0) {
+        log.info("Scheduling feed processing for feedId: {}", feedId)
+        
+        val message = FeedProcessingMessage(
+            feedId = feedId,
+            feedUrl = feedUrl,
+            repositoryId = repositoryId,
+            priority = priority
+        )
+        
+        messageProducer.sendFeedProcessingMessage(message)
+    }
+
+    /**
+     * Schedule document processing for a given document
+     */
+    fun scheduleDocumentProcessing(documentId: String, documentUrl: String, extractionType: String = "FULL", priority: Int = 0) {
+        log.info("Scheduling document processing for documentId: {}", documentId)
+        
+        val message = DocumentProcessingMessage(
+            documentId = documentId,
+            documentUrl = documentUrl,
+            extractionType = extractionType,
+            priority = priority
+        )
+        
+        messageProducer.sendDocumentProcessingMessage(message)
+    }
+
+    /**
+     * Send notification to a user
+     */
+    fun sendUserNotification(userId: String, type: String, title: String, content: String, metadata: Map<String, Any> = emptyMap()) {
+        log.info("Sending notification to user: {}, type: {}", userId, type)
+        
+        val message = NotificationMessage(
+            userId = userId,
+            type = type,
+            title = title,
+            content = content,
+            metadata = metadata
+        )
+        
+        messageProducer.sendNotificationMessage(message)
+    }
+
+    /**
+     * Track analytics event
+     */
+    fun trackAnalyticsEvent(eventType: String, userId: String? = null, sessionId: String? = null, properties: Map<String, Any> = emptyMap()) {
+        log.debug("Tracking analytics event: {}", eventType)
+        
+        val message = AnalyticsMessage(
+            eventType = eventType,
+            userId = userId,
+            sessionId = sessionId,
+            properties = properties
+        )
+        
+        messageProducer.sendAnalyticsMessage(message)
+    }
+
+    /**
+     * Batch schedule multiple feed processing tasks
+     */
+    fun batchScheduleFeedProcessing(feeds: List<Pair<String, String>>, priority: Int = 0) {
+        log.info("Batch scheduling {} feed processing tasks", feeds.size)
+        
+        feeds.forEach { (feedId, feedUrl) ->
+            try {
+                scheduleFeedProcessing(feedId, feedUrl, priority = priority)
+            } catch (e: Exception) {
+                log.error("Failed to schedule feed processing for feedId: {}", feedId, e)
+                // Continue with other feeds even if one fails
+            }
+        }
+    }
+
+    /**
+     * Send high priority feed processing message
+     */
+    fun scheduleUrgentFeedProcessing(feedId: String, feedUrl: String, repositoryId: String? = null) {
+        log.info("Scheduling urgent feed processing for feedId: {}", feedId)
+        scheduleFeedProcessing(feedId, feedUrl, repositoryId, priority = 10)
+    }
+
+    /**
+     * Send delayed notification (requires RabbitMQ delayed message plugin)
+     */
+    fun scheduleDelayedNotification(userId: String, type: String, title: String, content: String, delayMinutes: Long) {
+        log.info("Scheduling delayed notification for user: {}, delay: {} minutes", userId, delayMinutes)
+        
+        val message = NotificationMessage(
+            userId = userId,
+            type = type,
+            title = title,
+            content = content
+        )
+        
+        val delayMillis = delayMinutes * 60 * 1000
+        messageProducer.sendDelayedMessage("notification", message, delayMillis)
+    }
+
+    /**
+     * Send system notification to all administrators
+     */
+    fun sendSystemNotification(title: String, content: String, severity: String = "INFO") {
+        log.info("Sending system notification: {}", title)
+        
+        // This would typically query for admin users, but for now we'll use a placeholder
+        val adminUsers = listOf("admin") // TODO: Replace with actual admin user query
+        
+        adminUsers.forEach { adminUserId ->
+            sendUserNotification(
+                userId = adminUserId,
+                type = "SYSTEM_ALERT",
+                title = title,
+                content = content,
+                metadata = mapOf("severity" to severity)
+            )
+        }
+    }
+
+    /**
+     * Track user activity for analytics
+     */
+    fun trackUserActivity(userId: String, sessionId: String, action: String, resource: String? = null) {
+        trackAnalyticsEvent(
+            eventType = "USER_ACTIVITY",
+            userId = userId,
+            sessionId = sessionId,
+            properties = mapOf(
+                "action" to action,
+                "resource" to (resource ?: "unknown"),
+                "timestamp" to System.currentTimeMillis()
+            )
+        )
+    }
+}
