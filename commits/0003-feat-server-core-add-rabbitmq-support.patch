+package org.migor.feedless.message
+
+import org.migor.feedless.config.RabbitMQConfig
+import org.slf4j.LoggerFactory
+import org.springframework.amqp.rabbit.annotation.RabbitListener
+import org.springframework.context.annotation.Profile
+import org.springframework.messaging.handler.annotation.Header
+import org.springframework.messaging.handler.annotation.Payload
+import org.springframework.stereotype.Service
+
+/**
+ * Service for consuming messages from RabbitMQ queues
+ */
+@Service
+@Profile("!test")
+class RabbitMessageConsumer {
+
+    private val log = LoggerFactory.getLogger(RabbitMessageConsumer::class.java)
+
+    /**
+     * Process feed processing messages
+     */
+    @RabbitListener(queues = [RabbitMQConfig.FEED_PROCESSING_QUEUE])
+    fun processFeedMessage(
+        @Payload message: FeedProcessingMessage,
+        @Header("amqp_receivedRoutingKey") routingKey: String
+    ) {
+        try {
+            log.info("Processing feed message: feedId={}, feedUrl={}", message.feedId, message.feedUrl)
+            
+            // TODO: Implement actual feed processing logic here
+            // This could involve:
+            // - Fetching the feed from the URL
+            // - Parsing the feed content
+            // - Extracting articles/items
+            // - Storing the processed data
+            // - Updating feed metadata
+            
+            log.debug("Feed processing details: repositoryId={}, priority={}", 
+                message.repositoryId, message.priority)
+            
+            // Simulate processing time
+            Thread.sleep(100)
+            
+            log.info("Successfully processed feed message: feedId={}", message.feedId)
+            
+        } catch (Exception e) {
+            log.error("Failed to process feed message: feedId={}", message.feedId, e)
+            // The message will be moved to DLQ due to our configuration
+            throw e
+        }
+    }
+
+    /**
+     * Process document processing messages
+     */
+    @RabbitListener(queues = [RabbitMQConfig.DOCUMENT_PROCESSING_QUEUE])
+    fun processDocumentMessage(
+        @Payload message: DocumentProcessingMessage,
+        @Header("amqp_receivedRoutingKey") routingKey: String
+    ) {
+        try {
+            log.info("Processing document message: documentId={}, documentUrl={}", 
+                message.documentId, message.documentUrl)
+            
+            // TODO: Implement actual document processing logic here
+            // This could involve:
+            // - Fetching the document from the URL
+            // - Extracting text content
+            // - Performing NLP analysis
+            // - Generating summaries
+            // - Storing processed content
+            
+            log.debug("Document processing details: extractionType={}, priority={}", 
+                message.extractionType, message.priority)
+            
+            // Simulate processing time
+            Thread.sleep(200)
+            
+            log.info("Successfully processed document message: documentId={}", message.documentId)
+            
+        } catch (Exception e) {
+            log.error("Failed to process document message: documentId={}", message.documentId, e)
+            throw e
+        }
+    }
+
+    /**
