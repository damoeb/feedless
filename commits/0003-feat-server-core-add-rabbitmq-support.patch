+package org.migor.feedless.message
+
+import com.fasterxml.jackson.annotation.JsonProperty
+import java.time.LocalDateTime
+import java.util.*
+
+/**
+ * Base message DTO for RabbitMQ messages
+ */
+abstract class RabbitMessageDTO(
+    @JsonProperty("messageId")
+    val messageId: String = UUID.randomUUID().toString(),
+    
+    @JsonProperty("timestamp")
+    val timestamp: LocalDateTime = LocalDateTime.now(),
+    
+    @JsonProperty("messageType")
+    val messageType: String
+)
+
+/**
+ * Feed processing message
+ */
+data class FeedProcessingMessage(
+    @JsonProperty("feedId")
+    val feedId: String,
+    
+    @JsonProperty("feedUrl")
+    val feedUrl: String,
+    
+    @JsonProperty("repositoryId")
+    val repositoryId: String? = null,
+    
+    @JsonProperty("priority")
+    val priority: Int = 0
+) : RabbitMessageDTO(messageType = "FEED_PROCESSING")
+
+/**
+ * Document processing message
+ */
+data class DocumentProcessingMessage(
+    @JsonProperty("documentId")
+    val documentId: String,
+    
+    @JsonProperty("documentUrl")
+    val documentUrl: String,
+    
+    @JsonProperty("extractionType")
+    val extractionType: String = "FULL",
+    
+    @JsonProperty("priority")
+    val priority: Int = 0
+) : RabbitMessageDTO(messageType = "DOCUMENT_PROCESSING")
+
+/**
+ * Notification message
+ */
+data class NotificationMessage(
+    @JsonProperty("userId")
+    val userId: String,
+    
+    @JsonProperty("type")
+    val type: String,
+    
+    @JsonProperty("title")
+    val title: String,
+    
+    @JsonProperty("content")
+    val content: String,
+    
+    @JsonProperty("metadata")
+    val metadata: Map<String, Any> = emptyMap()
+) : RabbitMessageDTO(messageType = "NOTIFICATION")
+
+/**
+ * Analytics event message
+ */
+data class AnalyticsMessage(
+    @JsonProperty("eventType")
+    val eventType: String,
+    
+    @JsonProperty("userId")
+    val userId: String? = null,
+    
+    @JsonProperty("sessionId")
+    val sessionId: String? = null,
+    
+    @JsonProperty("properties")
+    val properties: Map<String, Any> = emptyMap(),
+    
+    @JsonProperty("timestamp")
+    override val timestamp: LocalDateTime = LocalDateTime.now()
+) : RabbitMessageDTO(messageType = "ANALYTICS")
