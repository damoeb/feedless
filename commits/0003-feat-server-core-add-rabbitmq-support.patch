+import org.junit.jupiter.api.extension.AfterAllCallback
+import org.junit.jupiter.api.extension.BeforeAllCallback
+import org.junit.jupiter.api.extension.ExtensionContext
+import org.slf4j.LoggerFactory
+import org.testcontainers.containers.RabbitMQContainer
+import org.testcontainers.containers.output.Slf4jLogConsumer
+
+/**
+ * JUnit 5 extension for RabbitMQ testcontainer support
+ */
+class RabbitMQExtension : BeforeAllCallback, AfterAllCallback {
+    
+    private val log = LoggerFactory.getLogger(RabbitMQExtension::class.simpleName)
+    
+    private lateinit var rabbitMQ: RabbitMQContainer
+
+    override fun beforeAll(context: ExtensionContext) {
+        val imageTag = "3.13-management-alpine"
+        
+        rabbitMQ = RabbitMQContainer(imageTag)
+            .withLogConsumer(Slf4jLogConsumer(log))
+            .withUser("testuser", "testpass")
+            .withVhost("test-vhost")
+            .withPermission("test-vhost", "testuser", ".*", ".*", ".*")
+            .withReuse(false)
+            .withExchange("test-exchange", "topic")
+            .withQueue("test-queue")
+            .withBinding("test-exchange", "test-queue", "test.#")
+
+        rabbitMQ.start()
+
+        log.info("RabbitMQ container started on port: {}", rabbitMQ.amqpPort)
+        
+        // Set system properties for Spring Boot to use the test RabbitMQ instance
+        System.setProperty("spring.rabbitmq.host", rabbitMQ.host)
+        System.setProperty("spring.rabbitmq.port", rabbitMQ.amqpPort.toString())
+        System.setProperty("spring.rabbitmq.username", "testuser")
+        System.setProperty("spring.rabbitmq.password", "testpass")
+        System.setProperty("spring.rabbitmq.virtual-host", "test-vhost")
+        
+        // Set management UI properties for debugging if needed
+        System.setProperty("rabbitmq.management.port", rabbitMQ.httpPort.toString())
+        System.setProperty("rabbitmq.management.url", "http://${rabbitMQ.host}:${rabbitMQ.httpPort}")
+    }
+
+    override fun afterAll(context: ExtensionContext) {
+        if (::rabbitMQ.isInitialized) {
+            rabbitMQ.stop()
+        }
+    }
+    
+    /**
+     * Get the RabbitMQ container instance for additional configuration in tests
+     */
+    fun getContainer(): RabbitMQContainer = rabbitMQ
+}
