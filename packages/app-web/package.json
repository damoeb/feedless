{
  "name": "app",
  "version": "0.0.1",
  "scripts": {
    "ng": "ng",
    "generate-verticals-data": "npx tsc generate-verticals-data.ts --ignoreConfig --strict false --module commonjs --outDir build/ && node build/generate-verticals-data.js",
    "prebuild": "npm run codegen",
    "prestart:feedless": "npm run codegen && dotenv -c .env -- sh generate-dev-app-config.sh feedless false",
    "start:feedless": "ng serve",
    "prestart:rss-proxy": "npm run codegen && dotenv -c .env -- sh generate-dev-app-config.sh rssProxy false",
    "start:rss-proxy": "ng serve",
    "prestart:page-change-tracker": "npm run codegen && dotenv -c .env -- sh generate-dev-app-config.sh pageChangeTracker false",
    "start:page-change-tracker": "ng serve",
    "prestart:untold-notes": "npm run codegen && dotenv -c .env -- sh generate-dev-app-config.sh untoldNotes true",
    "start:untold-notes": "ng serve",
    "prestart:reader": "npm run codegen && dotenv -c .env -- sh generate-dev-app-config.sh reader false",
    "start:reader": "ng serve",
    "prestart:visual-diff": "npm run codegen && dotenv -c .env -- sh generate-dev-app-config.sh visualDiff false",
    "start:visual-diff": "ng serve",
    "build": "ng build",
    "build:prod": "ng build -c production && npm run generate-verticals-data",
    "test": "jest",
    "test:ci": "jest --ci --coverage --watchAll=false",
    "test:watch": "jest --watch",
    "lint": "prettier --write --log-level=warn .",
    "outdated": "upgrade-interactive --latest",
    "codegen": "graphql-codegen --config codegen.yml",
    "clean": "rm -rf www build coverage .angular .gradle all-verticals.json src/generated"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "22.1.7",
    "@angular/cdk": "^22.1.7",
    "@angular/common": "22.1.7",
    "@angular/core": "22.1.7",
    "@angular/forms": "22.1.7",
    "@angular/platform-browser": "22.1.7",
    "@angular/router": "22.1.7",
    "@angular/service-worker": "22.1.7",
    "@apollo/client": "3.14.1",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/merge": "^6.12.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.5",
    "@codemirror/view": "^6.43.12",
    "@ionic/angular": "^8.8.19",
    "@justinribeiro/lite-youtube": "1.9.0",
    "@ngx-translate/core": "^16.0.4",
    "@ngx-translate/http-loader": "^16.0.1",
    "d3-scale": "4.0.2",
    "dayjs": "^1.11.23",
    "dexie": "^4.4.6",
    "dexie-observable": "^4.0.1-beta.13",
    "flexsearch": "^0.8.212",
    "graphql": "^16.14.2",
    "graphql-ws": "^5.16.2",
    "img-comparison-slider": "^8.0.7",
    "ionicons": "^7.4.0",
    "jwt-decode": "4.0.0",
    "leaflet": "^1.9.4",
    "lodash-es": "4.18.1",
    "marked": "^15.0.12",
    "pixelmatch": "^6.0.0",
    "platform": "^1.3.6",
    "rxjs": "~7.8.2",
    "schema-dts": "^1.1.5",
    "tslib": "^2.8.1",
    "typesafe-routes": "^12.3.0",
    "uuid": "^13.0.2",
    "zone.js": "0.16.3"
  },
  "devDependencies": {
    "@angular-builders/jest": "^22.0.1",
    "@angular-eslint/eslint-plugin": "^22.5.0",
    "@angular-eslint/eslint-plugin-template": "^22.5.0",
    "@angular-eslint/schematics": "^22.5.0",
    "@angular-eslint/template-parser": "^22.5.0",
    "@angular/build": "22.1.8",
    "@angular/cli": "22.1.8",
    "@angular/compiler": "22.1.7",
    "@angular/compiler-cli": "22.1.7",
    "@angular/language-service": "22.1.7",
    "@badisi/wdio-harness": "^4.4.1",
    "@graphql-codegen/cli": "^6.3.1",
    "@graphql-codegen/typescript": "^5.0.10",
    "@graphql-codegen/typescript-document-nodes": "^5.0.10",
    "@graphql-codegen/typescript-operations": "^5.1.0",
    "@ionic/angular-toolkit": "^13.0.0",
    "@types/d3-scale": "^4.0.9",
    "@types/jest": "^30.0.0",
    "@types/js-cookie": "^3.0.6",
    "@types/leaflet": "^1.9.22",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "20.19.43",
    "@types/pixelmatch": "^5.2.6",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^50.8.0",
    "eslint-plugin-prefer-arrow": "^1.2.3",
    "eslint-plugin-prettier": "^5.5.6",
    "fake-indexeddb": "^6.2.5",
    "jest": "^30.5.1",
    "jest-environment-jsdom": "^30.5.1",
    "jest-preset-angular": "^17.0.0",
    "jest-transform-stub": "^2.0.0",
    "jsdom": "^27.4.0",
    "prettier": "~3.9.8",
    "sitemap": "^8.0.3",
    "ts-jest": "^29.4.12",
    "ts-node": "10.9.2",
    "typescript": "6.0.3"
  }
}
